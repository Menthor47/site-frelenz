---
// /contact/ (§4.5): formularul, contactele directe, „Din București, lucrez cu firme din toată țara” și datele firmei
// (`#date-firma`, LegalId complet, ținta linkului „Date de identificare” din subsol). Harta din bandă are toate liniile
// estompate (§5.6). Antetul nu are butonul „Cere o ofertă” aici (Header). Formularul nu are JavaScript (§3.5); singurul
// script al paginii e cel al trenurilor din bandă (decizia 28), iar formularul se trimite și fără el.
// JSON-LD: ContactPage; BreadcrumbList vine din Base (ruling R10).
import { paginaAprobata } from '../../approvals';
import ContactForm from '../../components/ContactForm.astro';
import ContacteDirecte from '../../components/ContacteDirecte.astro';
import LegalId from '../../components/LegalId.astro';
import Base from '../../layouts/Base.astro';
import { nodContactPage } from '../../lib/jsonld';
import { PAGINI_STATICE } from '../../lib/routes';

const CALE = '/contact/';
---

<Base
  titlu={PAGINI_STATICE['/contact/'].titlu}
  descriere={PAGINI_STATICE['/contact/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodContactPage()]}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Contact', cale: CALE },
  ]}
  harta={{}}
  suprafata={true}
>
  <div class="contener contact">
    <h1>Cere o ofertă</h1>
    <p class="contact__intro">
      Spune-mi ce site ai și ce te încurcă, iar eu îți trimit oferta. Din București, lucrez cu firme din toată țara.
    </p>

    <div class="contact__grila">
      <section class="carte carte--formular" aria-labelledby="formular-titlu">
        <h2 id="formular-titlu" class="ascuns">Formularul</h2>
        <ContactForm />
      </section>

      <section class="carte contact__direct" aria-labelledby="direct-titlu">
        <h2 id="direct-titlu">Sau scrie-mi direct</h2>
        <ContacteDirecte />
      </section>
    </div>

    <section class="carte contact__firma" id="date-firma" aria-labelledby="date-firma-titlu">
      <h2 id="date-firma-titlu">Date de identificare</h2>
      <LegalId variant="complet" />
    </section>
  </div>
</Base>

<style>
  .contact {
    padding-block: 1rem 3.5rem;
  }

  h1 {
    margin-top: 0.5rem;
  }

  .contact__intro {
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: 1.45;
  }

  .contact__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  /* Containerul grilei din formular: lățimea cardului (nu a ecranului) hotărăște când câmpurile trec pe două coloane. */
  .carte--formular {
    container-type: inline-size;
  }

  /* Pe desktop, formularul la stânga, contactele directe la dreapta, aliniate sus. */
  @media (min-width: 64rem) {
    .contact__grila {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .contact__firma {
    margin-top: 1.5rem;
  }

  /* Cardul îngust din dreapta: titlul e mai mic, iar rândurile se umplu în ordine (nu echilibrat), ca „scrie-mi” să nu se
     rupă la cratimă. Echilibrarea din base.css alegea tocmai ruptura „Sau scrie- / mi direct”; fontul nu are U+2011. */
  .contact__direct h2 {
    font-size: var(--text-lg);
    text-wrap: wrap;
  }

  /* „Formularul” repetă H1-ul „Cere o ofertă”: rămâne pentru cititoarele de ecran, nu se vede. */
  .ascuns {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
