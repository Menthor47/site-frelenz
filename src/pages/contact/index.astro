---
// /contact/ (§4.5): formularul, contactele directe, „Din București, lucrez cu firme din toată țara” și datele firmei
// (`#date-firma`, LegalId complet, ținta linkului „Date de identificare” din subsol). Harta din bandă are toate liniile
// estompate (§5.6). Antetul nu are butonul „Cere o ofertă” aici (Header). Fără niciun JavaScript (§3.5).
// JSON-LD: ContactPage; BreadcrumbList vine din Base (ruling R10).
import { paginaAprobata } from '../../approvals';
import ContactForm from '../../components/ContactForm.astro';
import ContacteDirecte from '../../components/ContacteDirecte.astro';
import LegalId from '../../components/LegalId.astro';
import Base from '../../layouts/Base.astro';
import { nodContactPage } from '../../lib/jsonld';

const CALE = '/contact/';
---

<Base
  titlu="Contact"
  descriere="Cere o ofertă lui Alex Ionescu: completează formularul sau scrie-i direct pe e-mail, la telefon sau pe WhatsApp. Lucrează cu firme din toată țara."
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodContactPage()]}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Contact', cale: CALE },
  ]}
  harta={{}}
>
  <div class="contener contact">
    <h1>Cere o ofertă</h1>
    <p class="contact__intro">
      Spune-mi ce site ai și ce te încurcă, iar eu îți trimit oferta. Din București, lucrez cu firme din toată țara.
    </p>

    <div class="contact__grila">
      <section aria-labelledby="formular-titlu">
        <h2 id="formular-titlu">Formularul</h2>
        <ContactForm />
      </section>

      <section aria-labelledby="direct-titlu">
        <h2 id="direct-titlu">Sau scrie-mi direct</h2>
        <ContacteDirecte />
      </section>
    </div>

    <section class="contact__firma" id="date-firma" aria-labelledby="date-firma-titlu">
      <h2 id="date-firma-titlu">Date de identificare</h2>
      <LegalId variant="complet" />
    </section>
  </div>
</Base>

<style>
  .contact {
    padding-block: 1rem 3.5rem;
  }

  h1 {
    margin-top: 0.5rem;
  }

  .contact__intro {
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: 1.45;
  }

  .contact__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 2.5rem;
  }

  /* Pe desktop, formularul la stânga, contactele directe la dreapta, aliniate sus. */
  @media (min-width: 64rem) {
    .contact__grila {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .contact__firma {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
