---
// Acasă (§4.3). Zona de sus are un singur rol: să spună în 3 secunde ce face Alex și unde se cere o ofertă.
// - Zona de sus e o compoziție (ruling R12): harta animată și, peste marginea ei de jos, H1-ul ca o plăcuță de stație,
//   albă și opacă, ca liniile și trenurile să intre sub ea și textul să rămână lizibil (§5.6). Sub hartă, subtitlul și butonul.
//   În DOM, harta vine după „Cere o ofertă”, ca butonul de oprire să urmeze în ordinea focusului; locul ei vine din grilă.
// - Apoi, liniștit: „De unde pornești?”, cele două trasee, proiectele (doar dacă există unul publicabil), întrebările
//   frecvente generale și banda albastră cu îndemnul final. Antetul nu are butonul „Cere o ofertă” pe Acasă (Header).
// Singurul script e cel al trenurilor (MetroMap). JSON-LD: WebPage și FAQPage, din aceleași întrebări ca pagina.
import { getCollection } from 'astro:content';
import { paginaAprobata } from '../approvals';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import LineDiagram from '../components/LineDiagram.astro';
import MetroMap from '../components/MetroMap.astro';
import ProiecteRezumat from '../components/ProiecteRezumat.astro';
import RouteMap from '../components/RouteMap.astro';
import { cereServiciu } from '../form-rules';
import Base from '../layouts/Base.astro';
import { DRAFT } from '../lib/env';
import { nodFaq, nodWebPage } from '../lib/jsonld';
import { proiectePublicabile } from '../lib/publish';
import { PAGINI_STATICE } from '../lib/routes';

const CALE = '/';

/** Câte proiecte intră pe Acasă (§4.3 punctul 5); restul sunt pe /proiecte/. */
const PROIECTE_PE_ACASA = 3;

const randuri = (await getCollection('servicii'))
  .map((intrare) => intrare.data)
  .sort((a, b) => a.ordine - b.ordine)
  .map((s) => ({ problema: s.problema, slug: s.slug, nume: cereServiciu(s.slug, 'Acasă').nume, grup: s.grup }));

const proiecte = proiectePublicabile((await getCollection('proiecte')).map((intrare) => intrare.data), DRAFT).slice(0, PROIECTE_PE_ACASA);

// Ciorne (§4.3 punctul 6), la „tu”: doar fapte din spec (§1, §4.5), fără termene și fără cifre. Nu repetă întrebările
// de pe paginile de servicii. Fiecare răspuns începe cu răspunsul direct.
const intrebari = [
  {
    intrebare: 'Afișezi prețuri?',
    raspuns: 'Nu. Prețul, reducerea și ce include abonamentul le stabilim după ce mă uit la site-ul tău.',
  },
  {
    intrebare: 'Ce se întâmplă după ce trimit cererea?',
    raspuns:
      'Mă uit la site-ul tău și la ce mi-ai scris, apoi îți trimit oferta: ce lucrez, în ce ordine și ce primești. Lucrul începe doar după ce accepți oferta.',
  },
  {
    intrebare: 'Lucrezi și cu firme din afara Bucureștiului?',
    raspuns: 'Da. Sunt din București și lucrez cu firme din toată țara.',
  },
  {
    intrebare: 'Pot cere doar o remediere, fără abonament?',
    raspuns: 'Da. Remedierea unică se încheie cu un raport. Abonamentul lunar e pentru cine vrea ca lucrul să continue, nu o condiție.',
  },
  {
    intrebare: 'Cu cine lucrezi?',
    raspuns: 'Lucrez doar cu firme, PFA-uri și alte entități profesionale.',
  },
];
---

<Base
  titlu={PAGINI_STATICE['/'].titlu}
  descriere={PAGINI_STATICE['/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodWebPage(CALE, { despreAlex: true }), ...nodFaq(intrebari, DRAFT)]}
  suprafata={true}
>
  <div class="acasa-sus">
    <h1 class="acasa-sus__titlu">Consultant SEO din București</h1>
    <p class="acasa-sus__subtitlu">SEO, site-uri și audituri pentru firme care vor să fie găsite în Google și în căutarea AI.</p>
    <div class="acasa-sus__buton">
      <Cta />
    </div>
    <MetroMap variant="animated" />
  </div>

  <section class="acasa-sectiune acasa-sectiune--carte" aria-labelledby="de-unde-pornesti">
    <div class="contener carte">
      <h2 id="de-unde-pornesti">De unde pornești?</h2>
      <LineDiagram randuri={randuri} />
    </div>
  </section>

  <section class="acasa-sectiune acasa-trasee" aria-labelledby="cum-lucram">
    <div class="contener">
      <h2 id="cum-lucram">Cum lucrăm: două trasee</h2>
      <RouteMap marime="compact" />
    </div>
  </section>

  {
    proiecte.length > 0 && (
      <section class="acasa-sectiune acasa-sectiune--carte" aria-labelledby="proiecte">
        <div class="contener carte">
          <h2 id="proiecte">Proiecte</h2>
          <ProiecteRezumat proiecte={proiecte} />
        </div>
      </section>
    )
  }

  <section class="acasa-sectiune acasa-sectiune--carte" aria-labelledby="intrebari">
    <div class="contener carte">
      <h2 id="intrebari">Întrebări frecvente</h2>
      <Faq intrebari={intrebari} />
    </div>
  </section>

  <div class="acasa-final">
    <div class="contener acasa-final__rand">
      <p class="acasa-final__text">Spune-mi ce site ai și ce te încurcă.</p>
      <Cta />
    </div>
  </div>
</Base>

<style>
  /* Grila zonei de sus: coloana din mijloc e containerul (72rem, cu marginile laterale); harta ia toată lățimea pe mobil
     și se aliniază singură cu containerul pe desktop (metro.css). H1-ul stă în același rând cu harta, deasupra ei. */
  .acasa-sus {
    display: grid;
    grid-template-columns:
      [lat-start] minmax(var(--gutter), 1fr)
      [text-start] minmax(0, var(--container))
      [text-end] minmax(var(--gutter), 1fr)
      [lat-end];
    padding-bottom: 3.5rem;
  }

  .acasa-sus > :global(.harta) {
    grid-column: lat;
    grid-row: 1;
    align-self: start;
  }

  /* Plăcuța de stație (§4.3 punctul 2): albă și opacă, cu colțuri drepte și text închis, pe banda întunecată (decizia 25).
     Marginea de sus o pune la 58% din înălțimea hărții, între M2 (la jumătate) și M3 (la două treimi), ca nicio linie să
     nu atingă muchia plăcuței: harta are înălțimea 1/5 din lățime, dar cel puțin 9rem (metro.css), deci 58% din înălțime
     e 11,6% din lățime sau 5,22rem. Procentul din `margin` se raportează la lățimea coloanei, aceeași cu a hărții. */
  .acasa-sus__titlu {
    position: relative;
    z-index: 1;
    grid-column: text;
    grid-row: 1;
    align-self: start;
    justify-self: start;
    /* Cât „Consultant SEO” (~7,25em în 800) plus padding: plăcuța se strânge pe text și rupe rândul după „SEO”. */
    max-inline-size: min(100%, 8.75em);
    margin: max(5.22rem, 11.6%) 0 0;
    padding: 0.35em 0.5em 0.4em;
    border: 1px solid var(--paper);
    background: var(--paper);
    color: var(--ink);
    /* Cu textul mărit la 200%, „București” n-ar încăpea întreg pe 320px. */
    overflow-wrap: break-word;
  }

  /* Pe telefon, butonul „Oprește trenurile” stă deasupra hărții (metro.css), deci harta coboară cu el; plăcuța H1-ului
     coboară cu aceeași înălțime, ca să rămână la aceeași distanță de muchia hărții: 0,5rem de sus și 44px de buton. */
  @media (max-width: 47.98rem) {
    .acasa-sus__titlu {
      margin-top: calc(max(5.22rem, 11.6%) + 0.5rem + 44px);
    }
  }

  .acasa-sus__subtitlu {
    grid-column: text;
    max-inline-size: 34ch;
    margin: 1.25rem 0 0;
    font-size: var(--text-md);
    line-height: 1.45;
  }

  .acasa-sus__buton {
    grid-column: text;
    margin-top: 1.25rem;
  }

  .acasa-sectiune {
    padding-block: 3.5rem;
  }

  /* Secțiunile-card stau pe suprafață, nu pe fundal alb: cardul (`.carte`) are deja padding-ul lui, deci între carduri
     rămâne doar un spațiu mic. Vine după regula de sus, cu aceeași specificitate, deci câștigă. */
  .acasa-sectiune--carte {
    padding-block: 1.5rem;
  }

  /* Două carduri una sub alta: spațiul dintre ele e cel de 1,5rem, nu dublul padding-ului. */
  .acasa-sectiune--carte + .acasa-sectiune--carte {
    padding-top: 0;
  }

  .acasa-sectiune h2 {
    margin-bottom: 1.5rem;
  }

  /* Traseele stau pe toată lățimea (§4.3 punctul 4), pe --albastru-benzi (opțiunea 2a, aleasă de Alex 2026-10-23). E mai
     vizibil decât --tint-blue, care e 1,14:1 față de alb. Restul locurilor cu --tint-blue rămân neschimbate. */
  .acasa-trasee {
    background: var(--albastru-benzi);
  }

  /* Banda albastră cu îndemnul final (§4.3 punctul 7). Pe albastru, doar text alb (§5.2); butonul devine alb, cu text
     negru, ca să nu se piardă în bandă, iar la hover primește doar subliniere (nu se închide la culoare sub text negru). */
  .acasa-final {
    padding-block: 2.5rem;
    background: var(--blue);
    color: var(--paper);
  }

  .acasa-final__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .acasa-final__text {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.25;
  }

  .acasa-final :global(.buton-cta),
  .acasa-final :global(.buton-cta:hover) {
    background: var(--paper);
    color: var(--ink);
  }

  /* Varianta 1b, aleasă de Alex (2026-10-23): banda de sus e întunecată, ca un prag. Liniile și trenurile stau pe
     întuneric și se citesc ca niște lumini, iar plăcuța H1-ului rămâne albă, ca o plăcuță de stație. Restul paginii
     rămâne luminos. Culorile sunt cele din previzualizarea aprobată: --noapte-text pe --noapte are 15,95:1. */
  .acasa-sus {
    padding-top: 0.5rem;
    background: var(--noapte);
    color: var(--noapte-text);
  }
</style>
