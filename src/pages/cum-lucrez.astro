---
// /cum-lucrez/ (§4.5): cele două trasee, mari (RouteMap), apoi cei patru pași explicați, desenați ca linia comună a ambelor
// trasee, cu explicația sub fiecare stație (PasiTraseu), cele două formate alăturate, fără cifre,
// cu fraza exactă despre preț, și mențiunea că lucrez doar cu firme (B2B). Harta din bandă are toate liniile la fel de
// estompate (§5.6). JSON-LD: WebPage; BreadcrumbList vine din Base (ruling R10). Fără JavaScript.
// Ciorne: explicațiile pașilor spun doar ce scrie deja în spec și în pașii serviciilor, fără termene (#14, #18).
import { paginaAprobata } from '../approvals';
import Indemn from '../components/Indemn.astro';
import PasiTraseu from '../components/PasiTraseu.astro';
import RouteMap from '../components/RouteMap.astro';
import Base from '../layouts/Base.astro';
import { nodWebPage } from '../lib/jsonld';
import { PAGINI_STATICE } from '../lib/routes';

const CALE = '/cum-lucrez/';

/** Aceiași pași ca stațiile din RouteMap, în aceeași ordine (testul îi compară cu harta randată). Valabili pentru toate serviciile. */
const PASI = [
  {
    nume: 'Evaluare',
    explicatie: 'Mă uit la site-ul tău și la ce mi-ai scris în cerere. Îți spun pe înțeles ce am găsit.',
  },
  {
    nume: 'Ofertă',
    explicatie: 'Îți trimit oferta: ce lucrez, în ce ordine și ce primești. Tu alegi formatul, remediere unică sau remediere cu abonament lunar.',
  },
  {
    nume: 'Lucru',
    explicatie: 'După ce accepți oferta, lucrez pe site, în ordinea din ofertă.',
  },
  {
    nume: 'Raport',
    explicatie: 'La final îți trimit un raport pe înțeles, cu ce am făcut și ce urmează. Cu abonament, lucrul continuă lunar după raport.',
  },
] as const;
---

<Base
  titlu={PAGINI_STATICE['/cum-lucrez/'].titlu}
  descriere={PAGINI_STATICE['/cum-lucrez/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodWebPage(CALE)]}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Cum lucrez', cale: CALE },
  ]}
  harta={{}}
  suprafata={true}
>
  <div class="contener cum">
    <h1>Cum lucrez</h1>
    <p class="cum__intro">
      Eu, Alex Ionescu, lucrez în patru pași: evaluare, ofertă, lucru și raport. De la ofertă, traseul are două variante: o
      remediere unică sau o remediere urmată de un abonament lunar. Lucrez doar cu firme, PFA-uri și alte entități profesionale.
    </p>
  </div>

  <section class="cum-trasee" aria-labelledby="doua-trasee">
    <div class="contener">
      <h2 id="doua-trasee">Două trasee</h2>
      <RouteMap marime="mare" />
    </div>
  </section>

  <div class="contener cum cum--sectiuni">
    <section class="carte" aria-labelledby="pasii">
      <h2 id="pasii">Cei patru pași</h2>
      <PasiTraseu pasi={PASI.map((pas) => ({ nume: pas.nume, text: pas.explicatie }))} linie="comuna" orizontal />
    </section>

    <section class="carte cum__formate" aria-labelledby="formate">
      <h2 id="formate">Remediere unică sau abonament lunar</h2>
      <div class="formate">
        <p class="format format--unic">Remedierea unică repară ce am găsit la evaluare și se încheie cu raportul.</p>
        <p class="format format--abonament">Cu abonamentul lunar, remedierea costă mai puțin, iar lucrul continuă lună de lună după ea.</p>
      </div>
      <p class="cum__pret">Prețul, reducerea și ce include abonamentul le stabilim după ce mă uit la site-ul tău.</p>
    </section>
  </div>

  <Indemn text="Spune-mi ce site ai și ce te încurcă." />
</Base>

<style>
  .cum {
    padding-block: 1rem 3rem;
  }

  /* Secțiunile de după banda cu trasee: același spațiu deasupra ca dedesubtul benzii. */
  .cum--sectiuni {
    padding-top: 3rem;
  }

  h1 {
    margin-top: 0.5rem;
  }

  /* Primul paragraf, cel pe care îl citesc motoarele AI (§6.4): puțin mai mare decât restul, ca pe paginile de serviciu. */
  .cum__intro {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  /* Traseele stau pe albastru deschis, pe toată lățimea (RouteMap lasă fundalul paginii): --albastru-benzi, ca banda de pe
     Acasă (decizia 26), care se vede pe suprafața paginii; --tint-blue ar dispărea pe ea. */
  .cum-trasee {
    padding-block: 3rem;
    background: var(--albastru-benzi);
  }

  .cum-trasee h2 {
    margin-bottom: 1.5rem;
  }

  /* Cardurile stau la 1,5rem unul de altul, ca pe celelalte pagini cu carduri. */
  .carte + .carte {
    margin-top: 1.5rem;
  }

  /* Cele două formate sunt variante egale, ca traseele de deasupra: alăturate de la un card de 40rem, fiecare cu eșantionul
     liniei lui (galbenul închis pentru remedierea unică, albastrul pentru abonament, ca în RouteMap), sub textul la măsura lui. */
  /* Containerul e cardul: o interogare nu se aplică elementului care o declară. */
  .cum__formate {
    container-type: inline-size;
  }

  .formate {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @container (min-width: 40rem) {
    .formate {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  .format {
    margin: 0;
  }

  .format::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 0.5rem;
    margin-bottom: 0.75rem;
    background: var(--culoare);
  }

  .format--unic {
    --culoare: var(--yellow-dark);
  }

  .format--abonament {
    --culoare: var(--blue);
  }

  .cum__pret {
    font-weight: 700;
  }

  /* Cu culorile forțate, eșantioanele trec pe culoarea textului, ca liniile din RouteMap. */
  @media (forced-colors: active) {
    .format::before {
      background: CanvasText;
    }
  }
</style>
