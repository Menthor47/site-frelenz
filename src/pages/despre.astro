---
// /despre/ (§4.5): cine e Alex, din faptele din spec (§1), apoi biografia, experiența și instrumentele (#4). Fără studii:
// Alex a cerut, pe 2026-10-22, ca experiența să le țină locul. Pe 2026-10-25 a cerut ca „Experiență” să arate patru
// proiecte, ca patru carduri, și să pomenească și acest site. Faptele vin din repo-urile lui și din răspunsurile lui:
// szitrans.eu (acordul, #7), Amsterdam Headshop (acordul magazinului, confirmat de Alex pe 2026-10-25), Grabber (aplicația
// și magazinul ei, ale lui Alex) și AETHER // LABS (conceptul lui, găzduit neschimbat la /concepte/aether-labs/). Fiecare
// card duce spre site-ul lui; szitrans.eu și Amsterdam Headshop primesc și linkul spre studiul de caz, doar când acela se
// construiește (§3.4), ca să nu ducă niciodată spre o pagină lipsă. Pagina așteaptă aprobarea lui Alex
// (src/approvals.ts). Profilurile apar doar dacă `site.profiluri` nu e gol
// (#5), cu `rel="me"`. Fără fotografie și fără cadru gol până există una reală (#6).
// Stratul de suprafețe (§4.5): pe desktop două coloane, povestea în carduri la stânga, un card de profil la dreapta (numele,
// rolul, uneltele din „Instrumente” și linkul spre datele firmei din Contact); pe mobil, una sub alta. Fără imagine în profil.
// În producție, o secțiune care e încă marcaj lipsește cu tot cu titlul ei (§3.4).
// JSON-LD: ProfilePage (mainEntity #alex) și Person complet, care îl înlocuiește pe cel minimal; BreadcrumbList din Base.
import { getCollection } from 'astro:content';
import { paginaAprobata } from '../approvals';
import Indemn from '../components/Indemn.astro';
import TextSauMarcaj from '../components/TextSauMarcaj.astro';
import Base from '../layouts/Base.astro';
import { DRAFT } from '../lib/env';
import { nodPerson, nodProfilePage } from '../lib/jsonld';
import { areValoare, faraMarcaje, hasMarker } from '../lib/marker';
import { proiectePublicabile } from '../lib/publish';
import { site } from '../site.config';
import { PAGINI_STATICE } from '../lib/routes';

const CALE = '/despre/';

/** O secțiune care e încă marcaj lipsește în producție (§3.4). `proiecte`: sub text vin cardurile proiectelor. */
const SECTIUNI: readonly { titlu: string; text: string; proiecte?: true }[] = [
  {
    titlu: 'Cine sunt',
    text: 'Lucrez singur. Când îmi scrii, vorbești direct cu cel care face lucrarea: eu mă uit la site, eu fac oferta și eu fac modificările. La final primești un raport cu ce am schimbat.',
  },
  {
    titlu: 'Experiență',
    proiecte: true,
    text: 'Patru proiecte la care am lucrat, de la site-ul unei firme la o aplicație a mea. Al cincilea e chiar site-ul pe care îl citești acum: l-am construit tot eu, pagină cu pagină.',
  },
  {
    titlu: 'Instrumente',
    text: 'Pentru site-uri noi folosesc Astro sau React, în TypeScript, iar pentru găzduire și formulare, Cloudflare. Pe site-urile WordPress lucrez cu WooCommerce și PHP. Verific fiecare pagină cu Lighthouse, axe și Playwright, iar tot codul îl țin în Git.',
  },
];

/**
 * Cardurile din „Experiență”, în ordinea cerută de Alex. Tot cardul e clicabil: linkul din titlu îl acoperă. `adresa` e rândul
 * de jos, care spune unde duce clicul. `studiu`: slug-ul studiului de caz, legat doar când acela se construiește (§3.4).
 */
const PROIECTE: readonly { nume: string; href: string; tip: string; text: string; adresa: string; studiu?: string }[] = [
  {
    nume: 'szitrans.eu',
    href: 'https://szitrans.eu/',
    tip: 'Site de firmă, în engleză și spaniolă',
    text: 'Site-ul unei firme de transport și logistică din Málaga. L-am construit și m-am ocupat de SEO-ul lui: am pus datele reale ale firmei în datele structurate și în etichetele meta și am adăugat toate paginile, în ambele limbi, în harta site-ului.',
    adresa: 'szitrans.eu',
    studiu: 'szitrans',
  },
  {
    nume: 'Amsterdam Headshop',
    href: 'https://www.amsterdam-headshop.ro/',
    tip: 'Magazin online pe WordPress și WooCommerce',
    text: 'Magazinul primește comenzi și în timp ce lucrez la el, așa că am pornit de la o copie locală, iar pe site-ul live a ajuns doar cod testat. I-am adus la zi subsolul și paginile legale, cu datele comerciantului și linkurile ANPC, am tradus bannerul de cookie-uri în română și i-am adăugat butonul de refuz.',
    adresa: 'amsterdam-headshop.ro',
    studiu: 'amsterdam-headshop',
  },
  {
    nume: 'Grabber',
    href: 'https://grab.agseo.pro/',
    tip: 'Aplicație pentru Windows, cu magazinul ei',
    text: 'O aplicație a mea, pentru Windows, care descarcă audio și video de pe web, plus magazinul ei online, pe Cloudflare Workers. Plata se face în SOL sau USDC și e verificată direct pe blockchain, iar cheia de licență apare pe pagină, fără cont.',
    adresa: 'grab.agseo.pro',
  },
  {
    nume: 'AETHER // LABS',
    href: '/concepte/aether-labs/',
    tip: 'Concept de site',
    text: 'Un concept de design pentru un studio imaginar de artiști digitali și programatori: particule animate în fundal, cursor propriu, filtre pentru lucrări și secțiuni care apar la derulare. Studioul, echipa și cifrele sunt inventate: e un exercițiu de stil, nu un client.',
    adresa: 'Deschide conceptul',
  },
];

/** Uneltele din profil: exact cele pe care le numește secțiunea „Instrumente” de mai sus, în ordinea din text. */
const UNELTE = ['Astro', 'React', 'TypeScript', 'Cloudflare', 'WordPress', 'WooCommerce', 'PHP', 'Lighthouse', 'axe', 'Playwright', 'Git'] as const;

const publicate = new Set(proiectePublicabile((await getCollection('proiecte')).map((intrare) => intrare.data), DRAFT).map((p) => p.slug));
// Un paragraf pe linia goală.
const sectiuni = faraMarcaje(SECTIUNI, (s) => hasMarker(s.text), DRAFT).map((s) => ({ ...s, paragrafe: s.text.split('\n\n') }));
const proiecte = PROIECTE.map((p) => ({
  ...p,
  studiu: p.studiu !== undefined && publicate.has(p.studiu) ? `/proiecte/${p.studiu}/` : undefined,
  // Linkurile spre alte site-uri primesc săgeata „↗”; conceptul, găzduit aici, primește „→”.
  sageata: p.href.startsWith('/') ? '→' : '↗',
}));
// Aceeași regulă ca `sameAs` din JSON-LD: fără valori goale sau marcaje.
const profiluri = site.profiluri.filter(areValoare);
---

<Base
  titlu={PAGINI_STATICE['/despre/'].titlu}
  descriere={PAGINI_STATICE['/despre/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodProfilePage(), nodPerson(true)]}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Despre', cale: CALE },
  ]}
  harta={{}}
  suprafata={true}
>
  <div class="contener despre">
    <h1>{site.nume}</h1>
    <p class="despre__intro">
      Sunt Alex Ionescu, consultant SEO și web design din București. Lucrez cu firme, PFA-uri și alte entități profesionale din
      toată țara: SEO, audit SEO, site-uri de prezentare, redesign, mentenanță și optimizare pentru căutarea AI.
    </p>
    <p>
      Pe pagina <a href="/cum-lucrez/">Cum lucrez</a> vezi pașii și cele două feluri în care putem lucra împreună.
    </p>

    <div class="despre__grila">
      <div class="despre__poveste">
        {
          sectiuni.map((s) => (
            <section class="carte">
              <h2>{s.titlu}</h2>
              {s.paragrafe.map((par) => (
                <p>
                  <TextSauMarcaj valoare={par} />
                </p>
              ))}
              {s.proiecte && (
                <ul class="despre__proiecte">
                  {proiecte.map((p) => (
                    <li class="proiect-exp">
                      <h3 class="proiect-exp__nume">
                        <a class="proiect-exp__link" href={p.href}>{p.nume}</a>
                      </h3>
                      <p class="proiect-exp__tip">{p.tip}</p>
                      <p>{p.text}</p>
                      <p class="proiect-exp__adresa" aria-hidden="true">
                        {p.adresa} <span>{p.sageata}</span>
                      </p>
                      {p.studiu && (
                        <p class="proiect-exp__studiu">
                          <a href={p.studiu}>Studiul de caz</a>
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        {
          profiluri.length > 0 && (
            <section class="carte">
              <h2>Profiluri</h2>
              <ul class="despre__profiluri">
                {profiluri.map((p) => (
                  <li>
                    <a href={p} rel="me">
                      {new URL(p).hostname.replace(/^www\./, '')}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="carte despre__profil" aria-label="Profil">
        <p class="despre__nume">{site.nume}</p>
        <p>Consultant SEO și web designer, din București.</p>
        <h2 class="despre__unelte-titlu">Unelte</h2>
        <ul class="despre__unelte">
          {UNELTE.map((u) => <li class="despre__unealta">{u}</li>)}
        </ul>
        <p><a href="/contact/#date-firma">Date de identificare</a></p>
      </aside>
    </div>
  </div>

  <Indemn text="Spune-mi ce site ai și ce te încurcă." />
</Base>

<style>
  .despre {
    padding-block: 1rem 3rem;
  }

  .despre > :global(*) {
    max-width: 34em;
  }

  /* Grila are nevoie de toată lățimea containerului; regula de mai sus ar limita-o la 34em. */
  .despre__grila {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .despre__grila {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .despre__profil {
    display: grid;
    /* Fără asta, coloana implicită (auto) crește până la cel mai lung cuvânt („WooCommerce”) și iese din card la text mărit. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .despre__nume {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 800;
  }

  /* „Unelte” e un subtitlu în cardul de profil: mai mic decât numele, care rămâne rândul cel mai mare din card. */
  .despre__unelte-titlu {
    margin: 0.5rem 0 0;
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0;
  }

  h1 {
    margin-top: 0.5rem;
  }

  /* Primul paragraf, cel pe care îl citesc motoarele AI (§6.4). */
  .despre__intro {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  /* Cardurile poveștii stau la 1,5rem unul de altul, ca pe celelalte pagini cu carduri; primul stă la linia profilului. */
  section + section {
    margin-top: 1.5rem;
  }

  .despre__profiluri {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cardurile proiectelor din „Experiență”: două pe rând când încap, unul pe telefon. Stau pe `--suprafata` în cardul alb
     și au sus o linie de cerneală, ca traseele de lucru (decizia 34: culorile grupurilor rămân doar pentru servicii). */
  .despre__proiecte {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .proiect-exp {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-top: 4px solid var(--ink);
    background: var(--suprafata);
  }

  .proiect-exp > * {
    margin: 0;
  }

  .proiect-exp:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .proiect-exp__nume {
    font-size: var(--text-md);
    letter-spacing: 0;
  }

  /* Tot cardul e clicabil (zona de atingere, §5.8): linkul din titlu îl acoperă, iar numele proiectului rămâne numele linkului. */
  .proiect-exp__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .proiect-exp__tip {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Rândul de jos spune unde duce clicul; `margin-top: auto` îl ține jos când cardurile de pe același rând au înălțimi diferite. */
  .proiect-exp__adresa {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Linkul spre studiul de caz stă deasupra celui care acoperă cardul, ca să se poată apăsa separat. */
  .proiect-exp__studiu {
    position: relative;
    z-index: 1;
  }

  .proiect-exp__studiu a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Uneltele din profil curg pe rânduri, fără buline, fără chenare și fără marginea implicită a listei, ca să stea la
     marginea titlului „Unelte”. */
  .despre__unelte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Un element flex nu se strânge sub cel mai lung cuvânt al lui, deci „WooCommerce” ieșea din card la text mărit pe 320px;
     cu `min-width: 0`, cuvântul se rupe la marginea cardului (`overflow-wrap` din base.css). */
  .despre__unealta {
    min-width: 0;
  }

  /* Zona de atingere de 44px (§5.8): linkurile spre profiluri sunt singure pe rând. */
  .despre__profiluri a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
