---
// /despre/ (§4.5): cine e Alex, din faptele din spec (§1), apoi biografia, studiile, experiența și instrumentele.
// Ciorna din 2026-10-22 ia experiența și instrumentele doar din repo-urile lui Alex (proiectele, fără nume: szitrans
// n-a dat încă acordul, #7, iar magazinul e anonim); studiile rămân marcajul #4 (rândul blochează lansarea). Pagina
// așteaptă aprobarea lui Alex (src/approvals.ts). Profilurile apar doar dacă `site.profiluri` nu e gol
// (#5), cu `rel="me"`. Fără fotografie și fără cadru gol până există una reală (#6).
// În producție, o secțiune care e încă marcaj lipsește cu tot cu titlul ei (§3.4).
// JSON-LD: ProfilePage (mainEntity #alex) și Person complet, care îl înlocuiește pe cel minimal; BreadcrumbList din Base.
import { paginaAprobata } from '../approvals';
import Indemn from '../components/Indemn.astro';
import TextSauMarcaj from '../components/TextSauMarcaj.astro';
import Base from '../layouts/Base.astro';
import { DRAFT } from '../lib/env';
import { nodPerson, nodProfilePage } from '../lib/jsonld';
import { areValoare, faraMarcaje, hasMarker } from '../lib/marker';
import { site } from '../site.config';
import { PAGINI_STATICE } from '../lib/routes';

const CALE = '/despre/';

/** Ce lipsește încă e marcajul #4; Alex corectează ciorna și dă studiile. */
const SECTIUNI = [
  {
    titlu: 'Cine sunt',
    text: 'Lucrez singur. Când îmi scrii, vorbești direct cu cel care face lucrarea: eu mă uit la site, eu fac oferta și eu fac modificările. La final primești un raport cu ce am schimbat.',
  },
  { titlu: 'Studii', text: '[DE COMPLETAT:#4]' },
  {
    titlu: 'Experiență',
    text: 'Am lucrat la site-ul bilingv, în engleză și spaniolă, al unei firme de transport și logistică din Spania: am corectat datele firmei din etichetele meta și din datele structurate, am adăugat paginile noi în harta site-ului și am eliminat erorile semnalate de TypeScript și ESLint. Pentru un magazin online pe WordPress și WooCommerce am scris un modul propriu, care pune în subsol datele de identificare și linkurile ANPC, adaugă paginile legale și bannerul de cookie-uri în română, cu buton de refuz, și face ca imaginea principală a paginii să se încarce prima. Acest site l-am construit tot eu.',
  },
  {
    titlu: 'Instrumente',
    text: 'Pentru site-uri noi folosesc Astro, TypeScript și Cloudflare. Pe site-urile existente lucrez cu WordPress, WooCommerce și PHP, dar și cu React, Vite și Tailwind CSS. Verific fiecare pagină cu Lighthouse, axe și Playwright. Pe site-urile WordPress lucrez întâi pe o copie locală, iar pe site-ul live ajunge doar cod testat și salvat în Git.',
  },
] as const;

const sectiuni = faraMarcaje(SECTIUNI, (s) => hasMarker(s.text), DRAFT);
// Aceeași regulă ca `sameAs` din JSON-LD: fără valori goale sau marcaje.
const profiluri = site.profiluri.filter(areValoare);
---

<Base
  titlu={PAGINI_STATICE['/despre/'].titlu}
  descriere={PAGINI_STATICE['/despre/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={[nodProfilePage(), nodPerson(true)]}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Despre', cale: CALE },
  ]}
  harta={{}}
>
  <div class="contener despre">
    <h1>{site.nume}</h1>
    <p class="despre__intro">
      Sunt Alex Ionescu, consultant SEO și web design din București. Lucrez cu firme, PFA-uri și alte entități profesionale din
      toată țara: SEO, audit SEO, site-uri de prezentare, redesign, mentenanță și optimizare pentru căutarea AI.
    </p>
    <p>
      Pe pagina <a href="/cum-lucrez/">Cum lucrez</a> vezi pașii și cele două feluri în care putem lucra împreună.
    </p>

    {
      sectiuni.map((s) => (
        <section>
          <h2>{s.titlu}</h2>
          <p>
            <TextSauMarcaj valoare={s.text} />
          </p>
        </section>
      ))
    }

    {
      profiluri.length > 0 && (
        <section>
          <h2>Profiluri</h2>
          <ul class="despre__profiluri">
            {profiluri.map((p) => (
              <li>
                <a href={p} rel="me">
                  {new URL(p).hostname.replace(/^www\./, '')}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <Indemn text="Spune-mi ce site ai și ce te încurcă." />
</Base>

<style>
  .despre {
    padding-block: 1rem 3rem;
  }

  .despre > :global(*) {
    max-width: 70ch;
  }

  h1 {
    margin-top: 0.5rem;
  }

  /* Primul paragraf, cel pe care îl citesc motoarele AI (§6.4). */
  .despre__intro {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  section {
    margin-top: 2.5rem;
  }

  .despre__profiluri {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Zona de atingere de 44px (§5.8): linkurile spre profiluri sunt singure pe rând. */
  .despre__profiluri a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
