---
// /servicii/ (§4.5): pagina de trecere spre cele 6 servicii, grupate pe cele 4 linii, fiecare cu răspunsul direct și
// „Ce primești” pe scurt. Nu repetă „De unde pornești?” de pe Acasă (problemele nu apar aici). Harta din bandă are toate
// liniile la fel de estompate (§5.6). JSON-LD: CollectionPage și ItemList cu serviciile; BreadcrumbList vine din Base.
import { getCollection } from 'astro:content';
import { paginaAprobata } from '../../approvals';
import Cta from '../../components/Cta.astro';
import FaraRupere from '../../components/FaraRupere.astro';
import { cereServiciu, type Grup } from '../../form-rules';
import Base from '../../layouts/Base.astro';
import { nodColectie } from '../../lib/jsonld';
import { PAGINI_STATICE } from '../../lib/routes';

const CALE = '/servicii/';

/** Numele liniilor, cu diacritice (în form-rules.ts valorile sunt ASCII). */
const NUME_LINIE: Readonly<Record<Grup, string>> = {
  vizibilitate: 'Vizibilitate',
  diagnostic: 'Diagnostic',
  constructie: 'Construcție',
  reparatie: 'Reparație',
};

/** Câte livrabile intră în „Ce primești” pe scurt; lista întreagă e pe pagina serviciului. */
const LIVRABILE_PE_SCURT = 3;

const servicii = (await getCollection('servicii'))
  .map((intrare) => intrare.data)
  .sort((a, b) => a.ordine - b.ordine)
  .map((s) => ({ ...s, nume: cereServiciu(s.slug, 'servicii/').nume, cale: `/servicii/${s.slug}/` }));

// Liniile, în ordinea în care apar primele lor servicii.
const linii = [...new Set(servicii.map((s) => s.grup))].map((grup) => ({ grup, servicii: servicii.filter((s) => s.grup === grup) }));
---

<Base
  titlu={PAGINI_STATICE['/servicii/'].titlu}
  descriere={PAGINI_STATICE['/servicii/'].descriere}
  cale={CALE}
  aprobat={paginaAprobata(CALE)}
  jsonld={nodColectie('servicii', servicii.map((s) => ({ nume: s.nume, cale: s.cale })))}
  firimituri={[
    { nume: 'Acasă', cale: '/' },
    { nume: 'Servicii', cale: CALE },
  ]}
  harta={{}}
  suprafata={true}
>
  <div class="contener servicii">
    <h1>Servicii</h1>
    <p class="servicii__intro">
      <FaraRupere
        text="Eu, Alex Ionescu, lucrez pe patru linii: vizibilitate (SEO și căutarea AI), diagnostic (auditul SEO), construcție (site-uri de prezentare noi) și reparație (redesign și mentenanță). Pe pagina fiecărui serviciu vezi pentru cine e, ce primești și cum se desfășoară."
      />
    </p>

    <div class="linii">
      {
        linii.map((linie) => (
          <section class:list={['linie-grup', linie.servicii.length > 1 && 'linie-grup--lata']} data-grup={linie.grup}>
            <h2 class="linie-grup__titlu">{NUME_LINIE[linie.grup]}</h2>
            <div class="linie-grup__servicii">
              {linie.servicii.map((s) => (
                <article class="serviciu carte serviciu-card">
                  <h3>
                    <a href={s.cale}>{s.nume}</a>
                  </h3>
                  <p>
                    <FaraRupere text={s.raspunsDirect} />
                  </p>
                  <p class="serviciu__eticheta">Ce primești, pe scurt:</p>
                  <ul>
                    {s.livrabile.slice(0, LIVRABILE_PE_SCURT).map((t) => (
                      <li>
                        <FaraRupere text={t} />
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="servicii__final">
      <p><FaraRupere text="Nu știi de unde să începi? Spune-mi ce site ai sau de ce ai nevoie și îți spun ce serviciu ți se potrivește." /></p>
      <Cta />
    </div>
  </div>
</Base>

<style>
  /* Culoarea liniei, `--culoare`, vine din `data-grup` (tokens.css) și dă segmentul din fața titlului și marcajele listei. */
  .servicii {
    padding-block: 1rem 3rem;
  }

  h1 {
    margin-top: 0.5rem;
  }

  .servicii__intro {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  /* Liniile, într-o grilă (decizia din 2026-10-23): pe desktop, o linie cu două servicii ia tot rândul, iar liniile cu un
     singur serviciu (Diagnostic, Construcție) stau câte două pe rând, ca rândul să nu rămână pe jumătate gol. Ordinea din
     DOM (deci și a focusului) e cea a câmpului `ordine`: grila nu reordonează nimic. */
  .linii {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 1.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 48rem) {
    .linii {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .linie-grup--lata {
      grid-column: 1 / -1;
    }
  }

  /* Coloana: titlul, apoi cardurile, întinse până la capătul rândului, ca două linii alăturate să se termine la fel. */
  .linie-grup {
    display: flex;
    flex-direction: column;
  }

  /* Titlul liniei are în față un tronson drept în culoarea ei, ca segmentele de pe harta de metrou.
     Desenul e decor: numele liniei e textul titlului. În coloana flex marginile nu se mai suprapun, deci spațiul de sub
     titlu e doar cel de deasupra cardurilor (1,5rem). */
  .linie-grup__titlu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
    /* Textul e un element flex: fără `anywhere`, cu textul mărit la 200%, „Construcție” ar ieși din pagină la 320px. */
    overflow-wrap: anywhere;
  }

  .linie-grup__titlu::before {
    content: '';
    flex: none;
    width: 3rem;
    height: 0.5rem;
    background: var(--culoare);
  }

  .linie-grup__servicii {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .linie-grup--lata .linie-grup__servicii {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Cardul e cardul comun al site-ului (`.carte`: alb, cu contur și padding), cu o bară de 4px în culoarea liniei
     (--culoare, moștenit din data-grup). Tot cardul e un singur link, ca rândurile din „De unde pornești?” de pe Acasă:
     linkul din titlu își întinde zona de click peste card (`h3 a::after`), iar cardul îi dă poziția. */
  .serviciu-card {
    position: relative;
    border-left: 4px solid var(--culoare);
  }

  /* Cuvintele lungi și numele de servicii se rup în card, la orice lățime (Review Focus 2): „Mentenanță” sau „Optimizare”,
     mărite la 200%, nu încap altfel într-un ecran de 320px. Linkul din titlu moștenește regula. */
  .serviciu-card h3 {
    overflow-wrap: anywhere;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  /* Numele serviciului e linkul spre pagina lui, cu zona de atingere de 44px (§5.8). Linkul are tot un singur nume, cel
     al serviciului, deci cititoarele de ecran nu aud cardul de două ori. */
  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .serviciu__eticheta {
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  li::marker {
    color: var(--culoare);
  }

  /* Linia stă pe suprafață, unde --rule (1,05:1) nu se vede; conturul cardurilor (--card-contur) se vede. */
  .servicii__final {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--card-contur);
  }
</style>
