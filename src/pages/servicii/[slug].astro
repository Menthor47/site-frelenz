---
// Cele 6 pagini de serviciu, câte una pe fișier din src/content/servicii (§4.4). Toate se construiesc, și neaprobate;
// `check:launch` refuză lansarea până când Alex le aprobă (§3.4). Pagina adună ce poate publica șablonul `Service`:
// serviciile înrudite, ghidurile legate (doar cu cel puțin 2 aprobate) și proiectul (doar dacă e publicabil).
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { SERVICII } from '../../form-rules';
import Service from '../../layouts/Service.astro';
import { DRAFT } from '../../lib/env';
import { ghiduriDeConstruit, proiectePublicabile } from '../../lib/publish';

export const getStaticPaths = (async () => {
  const servicii = (await getCollection('servicii')).map((intrare) => intrare.data);
  return servicii.map((serviciu) => ({ params: { slug: serviciu.slug }, props: { serviciu } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { serviciu } = Astro.props;

const servicii = (await getCollection('servicii')).map((intrare) => intrare.data);
const inrudite = serviciu.inrudite.map((slug) => {
  const date = servicii.find((s) => s.slug === slug);
  const regula = SERVICII.find((s) => s.slug === slug);
  if (date === undefined || regula === undefined) {
    throw new Error(`${serviciu.slug}: serviciul înrudit „${slug}” nu are fișier în src/content/servicii`);
  }
  return { slug, nume: regula.nume, problema: date.problema };
});

const ghiduri = ghiduriDeConstruit((await getCollection('ghiduri')).map((intrare) => intrare.data), DRAFT)
  .filter((ghid) => ghid.serviciuLegat === serviciu.slug)
  .map((ghid) => ({ slug: ghid.slug, titlu: ghid.titlu }));

const gasit =
  serviciu.proiect === undefined
    ? undefined
    : proiectePublicabile((await getCollection('proiecte')).map((intrare) => intrare.data), DRAFT).find((p) => p.slug === serviciu.proiect);
const proiect = gasit && { slug: gasit.slug, titlu: gasit.titlu, context: gasit.context };
---

<Service serviciu={serviciu} inrudite={inrudite} ghiduri={ghiduri} proiect={proiect} />
