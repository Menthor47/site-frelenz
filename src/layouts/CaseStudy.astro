---
// Studiul de caz (§4.5): contextul → problema → ce am făcut → rezultatul → serviciile folosite, apoi un singur îndemn.
// La rezultat intră doar ce se poate dovedi, ca text, cu sursa și data, plus capturi cu text alternativ (§6.4).
// Banda are linia primului serviciu din `servicii[]`, cu „Ești aici” (§5.6). JSON-LD: Article (about = serviciile
// folosite, autor #alex); BreadcrumbList vine din Base (ruling R10).
// Niciun marcaj nu apare ca text brut (§3.4): în previzualizare trece prin `Placeholder`, iar în producție câmpul lipsește,
// cu tot cu secțiunea lui dacă rămâne goală. Un rezultat cu marcaj nu e verificabil, deci lipsește.
// Doar pe /proiecte/acest-site/ (§4.5, §5.5): scorurile măsurate în producție, cu data și versiunea, și fișa paginii.
import type { CollectionEntry } from 'astro:content';
import Cta from '../components/Cta.astro';
import PageFacts from '../components/PageFacts.astro';
import Placeholder from '../components/Placeholder.astro';
import TextSauMarcaj from '../components/TextSauMarcaj.astro';
import { SERVICII } from '../form-rules';
import { DRAFT } from '../lib/env';
import { nodArticle, tipuriPagina } from '../lib/jsonld';
import { hasMarker } from '../lib/marker';
import Base from './Base.astro';

type Proiect = CollectionEntry<'proiecte'>['data'];

interface Props {
  proiect: Pick<Proiect, 'slug' | 'titlu' | 'descriere' | 'aprobat' | 'context' | 'problema' | 'ceAmFacut' | 'rezultate' | 'servicii' | 'capturi' | 'scoruri'>;
}

const { proiect: p } = Astro.props;

const cale = `/proiecte/${p.slug}/`;
const firimituri = [
  { nume: 'Acasă', cale: '/' },
  { nume: 'Proiecte', cale: '/proiecte/' },
  { nume: p.titlu, cale },
];
const jsonld = [nodArticle({ cale, titlu: p.titlu, despre: p.servicii })];
const acestSite = p.slug === 'acest-site';
const scoruri = p.scoruri ?? [];

/** În producție rămân doar valorile fără marcaj; în previzualizare rămân toate, iar marcajul se vede. */
const deArata = <T,>(lista: readonly T[], areMarcaj: (x: T) => boolean): readonly T[] => (DRAFT ? lista : lista.filter((x) => !areMarcaj(x)));

const context = deArata([p.context], hasMarker)[0];
const problema = deArata([p.problema], hasMarker)[0];
const ceAmFacut = deArata(p.ceAmFacut, hasMarker);
const rezultate = deArata(p.rezultate, (r) => hasMarker(r.text) || hasMarker(r.sursa));

const servicii = p.servicii.map((slug) => {
  const s = SERVICII.find((x) => x.slug === slug);
  if (s === undefined) throw new Error(`${p.slug}: serviciul „${slug}” nu e în src/form-rules.ts`);
  return s;
});
const grup = servicii[0]?.grup;

/** Luna și anul. `z.coerce.date()` dă miezul nopții UTC, deci luna se citește în UTC. */
const luna = (data: Date) => data.toLocaleDateString('ro-RO', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  titlu={p.titlu}
  descriere={p.descriere}
  cale={cale}
  aprobat={p.aprobat}
  jsonld={jsonld}
  firimituri={firimituri}
  harta={{ line: grup }}
>
  <div class="contener caz">
    <h1>{p.titlu}</h1>

    {
      context !== undefined && (
        <section>
          <h2>Contextul</h2>
          <p class="caz__context">
            <TextSauMarcaj valoare={context} />
          </p>
        </section>
      )
    }

    {
      problema !== undefined && (
        <section>
          <h2>Problema</h2>
          <p>
            <TextSauMarcaj valoare={problema} />
          </p>
        </section>
      )
    }

    {
      ceAmFacut.length > 0 && (
        <section>
          <h2>Ce am făcut</h2>
          <ul>
            {ceAmFacut.map((t) => (
              <li>
                <TextSauMarcaj valoare={t} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (rezultate.length > 0 || p.capturi.length > 0) && (
        <section>
          <h2>Rezultatul</h2>
          {rezultate.length > 0 && (
            <ul>
              {rezultate.map((r) => (
                <li>
                  <TextSauMarcaj valoare={r.text} /> Sursa: <TextSauMarcaj valoare={r.sursa} />, {luna(r.data)}.
                </li>
              ))}
            </ul>
          )}
          {p.capturi.map((c) => (
            <figure class="caz__captura">
              <img src={c.src} alt={c.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </section>
      )
    }

    <section>
      <h2>Serviciile folosite</h2>
      <ul class="caz__servicii">
        {
          servicii.map((s) => (
            <li>
              <a href={`/servicii/${s.slug}/`}>{s.nume}</a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      acestSite && (
        <section>
          <h2>Scorurile, măsurate în producție</h2>
          {scoruri.length > 0 ? (
            <ul>
              {scoruri.map((s) => (
                <li>
                  {s.sursa}: {s.valoare} (Lighthouse {s.versiuneLighthouse}, {luna(s.data)})
                </li>
              ))}
            </ul>
          ) : (
            <p>
              <Placeholder nr={11} />
            </p>
          )}
          <p>
            Site-ul nu setează niciun cookie și nu încarcă scripturi de la alte firme. Excepția, un cookie strict necesar pe care
            Cloudflare îl poate pune în anumite situații, e explicată în <a href="/politica-cookies/">Politica de cookie-uri</a>.
          </p>
        </section>
      )
    }

    {
      acestSite && (
        <section>
          <h2>Fișa acestei pagini</h2>
          <PageFacts tipuriSchema={tipuriPagina(jsonld, firimituri)} />
        </section>
      )
    }
  </div>

  <div class="indemn">
    <div class="contener indemn__rand">
      <p class="indemn__text">Spune-mi ce site ai și ce te încurcă.</p>
      <Cta />
    </div>
  </div>
</Base>

<style>
  .caz {
    padding-block: 1rem 3rem;
  }

  h1 {
    max-width: 24ch;
    margin-top: 0.5rem;
  }

  .caz :global(section) {
    max-width: 70ch;
    margin-top: 2.5rem;
  }

  /* Contextul e primul paragraf, cel pe care îl citesc motoarele AI (§6.4). */
  .caz__context {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  li + li {
    margin-top: 0.4rem;
  }

  .caz__servicii {
    padding: 0;
    list-style: none;
  }

  /* Zona de atingere de 44px (§5.8): linkurile spre servicii sunt singure pe rând. */
  .caz__servicii a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .caz__captura {
    margin: 1.5rem 0 0;
  }

  .caz__captura img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .indemn {
    padding-block: 2rem;
    background: var(--tint-blue);
  }

  .indemn__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .indemn__text {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.3;
  }
</style>
