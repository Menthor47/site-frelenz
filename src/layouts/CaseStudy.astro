---
// Studiul de caz (§4.5): contextul → problema → ce am făcut → rezultatul → serviciile folosite, apoi un singur îndemn.
// La rezultat intră doar ce se poate dovedi, ca text, cu sursa și data, plus capturi cu text alternativ (§6.4), prin
// astro:assets (§9.1): `<Image>` le dă lățime și înălțime, format WebP și încărcare leneșă.
// Banda are linia primului serviciu din `servicii[]`, cu „Ești aici” (§5.6). JSON-LD: Article (about = serviciile
// folosite, autor #alex); BreadcrumbList vine din Base (ruling R10).
// Niciun marcaj nu apare ca text brut (§3.4): în previzualizare trece prin `Placeholder`, iar în producție câmpul lipsește,
// cu tot cu secțiunea lui dacă rămâne goală. Un rezultat cu marcaj nu e verificabil, deci lipsește (și nu primește dată).
// `serviciiDeConfirmat` e marcajul serviciilor încă provizorii: se vede doar în previzualizare, lângă listă.
// Doar pe /proiecte/acest-site/ (§4.5, §5.5): rezultatul sunt scorurile măsurate în producție, iar la final vine fișa paginii.
// Titlul stă pe suprafață; secțiunile, într-un singur card alb (decizia din 2026-10-23).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Indemn from '../components/Indemn.astro';
import PageFacts from '../components/PageFacts.astro';
import Placeholder from '../components/Placeholder.astro';
import TextSauMarcaj from '../components/TextSauMarcaj.astro';
import { cereServiciu } from '../form-rules';
import { DRAFT } from '../lib/env';
import { lunaAn } from '../lib/format';
import { nodArticle, tipuriPagina } from '../lib/jsonld';
import { faraMarcaje, hasMarker } from '../lib/marker';
import Base from './Base.astro';

type Proiect = CollectionEntry<'proiecte'>['data'];

interface Props {
  proiect: Pick<
    Proiect,
    'slug' | 'titlu' | 'descriere' | 'aprobat' | 'context' | 'problema' | 'ceAmFacut' | 'rezultate' | 'servicii' | 'serviciiDeConfirmat' | 'capturi' | 'scoruri'
  >;
}

const { proiect: p } = Astro.props;

const cale = `/proiecte/${p.slug}/`;
const firimituri = [
  { nume: 'Acasă', cale: '/' },
  { nume: 'Proiecte', cale: '/proiecte/' },
  { nume: p.titlu, cale },
];
const jsonld = [nodArticle({ cale, titlu: p.titlu, despre: p.servicii })];
const acestSite = p.slug === 'acest-site';
const scoruri = p.scoruri ?? [];

const rezultatCuMarcaj = (r: Proiect['rezultate'][number]) => hasMarker(r.text) || hasMarker(r.sursa);
const context = faraMarcaje([p.context], hasMarker, DRAFT)[0];
const problema = faraMarcaje([p.problema], hasMarker, DRAFT)[0];
const ceAmFacut = faraMarcaje(p.ceAmFacut, hasMarker, DRAFT);
const rezultate = faraMarcaje(p.rezultate, rezultatCuMarcaj, DRAFT);
const areRezultat = acestSite || rezultate.length > 0 || p.capturi.length > 0;

const servicii = p.servicii.map((slug) => cereServiciu(slug, `proiecte/${p.slug}`));
const grup = servicii[0]?.grup;
---

<Base titlu={p.titlu} descriere={p.descriere} cale={cale} aprobat={p.aprobat} jsonld={jsonld} firimituri={firimituri} harta={{ line: grup }} suprafata={true} articol={true}>
  <div class="contener caz">
    <h1><TextSauMarcaj valoare={p.titlu} /></h1>

    <div class="caz__corp carte">
      {
        context !== undefined && (
          <section>
            <h2>Contextul</h2>
            <p class="caz__context">
              <TextSauMarcaj valoare={context} />
            </p>
          </section>
        )
      }

      {
        problema !== undefined && (
          <section>
            <h2>Problema</h2>
            <p>
              <TextSauMarcaj valoare={problema} />
            </p>
          </section>
        )
      }

      {
        ceAmFacut.length > 0 && (
          <section>
            <h2>Ce am făcut</h2>
            <ul>
              {ceAmFacut.map((t) => (
                <li>
                  <TextSauMarcaj valoare={t} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        areRezultat && (
          <section>
            <h2>Rezultatul</h2>
            {acestSite &&
              (scoruri.length > 0 ? (
                <ul>
                  {scoruri.map((s) => (
                    <li>
                      {s.sursa}: {s.valoare} (Lighthouse {s.versiuneLighthouse}, {lunaAn(s.data)})
                    </li>
                  ))}
                </ul>
              ) : (
                <p>
                  <Placeholder nr={11} />
                </p>
              ))}
            {rezultate.length > 0 && (
              <ul>
                {rezultate.map((r) =>
                  rezultatCuMarcaj(r) ? (
                    <li>
                      <TextSauMarcaj valoare={r.text} /> <TextSauMarcaj valoare={r.sursa} />
                    </li>
                  ) : (
                    <li>
                      {r.text} Sursa: {r.sursa}, {lunaAn(r.data)}.
                    </li>
                  ),
                )}
              </ul>
            )}
            {p.capturi.map((c) => (
              <figure class="caz__captura">
                <Image src={c.src} alt={c.alt} />
              </figure>
            ))}
          </section>
        )
      }

      <section>
        <h2>Serviciile folosite</h2>
        <ul class="caz__servicii">
          {
            servicii.map((s) => (
              <li>
                <a href={`/servicii/${s.slug}/`}>{s.nume}</a>
              </li>
            ))
          }
        </ul>
        {
          p.serviciiDeConfirmat !== undefined && DRAFT && (
            <p>
              <TextSauMarcaj valoare={p.serviciiDeConfirmat} />
            </p>
          )
        }
      </section>

      {
        acestSite && (
          <section>
            <h2>Fișa acestei pagini</h2>
            <p>
              Site-ul nu setează niciun cookie și nu încarcă scripturi de la alte firme. Excepția, un cookie strict necesar pe care
              Cloudflare îl poate pune în anumite situații, e explicată în <a href="/politica-cookies/">Politica de cookie-uri</a>.
              Fișa de mai jos le măsoară chiar pe pagina asta.
            </p>
            <PageFacts tipuriSchema={tipuriPagina(jsonld, firimituri)} />
          </section>
        )
      }
    </div>
  </div>

  <Indemn text="Spune-mi ce site ai și ce te încurcă." />
</Base>

<style>
  .caz {
    padding-block: 1rem 3rem;
  }

  h1 {
    max-width: 24ch;
    margin-top: 0.5rem;
  }

  .caz :global(section) {
    max-width: 70ch;
    margin-top: 2.5rem;
  }

  /* Secțiunile stau într-un singur card alb (decizia din 2026-10-23); prima stă sub paddingul cardului, fără spațiul dintre secțiuni. */
  .caz__corp > :global(section:first-child) {
    margin-top: 0;
  }

  /* Contextul e primul paragraf, cel pe care îl citesc motoarele AI (§6.4). */
  .caz__context {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  li + li {
    margin-top: 0.4rem;
  }

  .caz__servicii {
    padding: 0;
    list-style: none;
  }

  /* Zona de atingere de 44px (§5.8): linkurile spre servicii sunt singure pe rând. */
  .caz__servicii a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .caz__captura {
    margin: 1.5rem 0 0;
  }

  /* `<img>`-ul îl scrie componenta `<Image>`, deci regula ajunge la el prin :global, din interiorul figurii. */
  .caz__captura :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
</style>
