---
// Șablonul paginii de serviciu (§4.4), același pentru toate 6. Ordinea din pagină e cea din spec:
// banda cu harta (linia grupului plină, „Ești aici”) și firimiturile, H1-ul cu cuvântul-cheie și răspunsul direct,
// „Pentru cine e” și „Semne că ai nevoie”, „Ce primești”, „Cum se desfășoară”, proiectul (dacă există), întrebările
// frecvente, nota despre garanții (doar pe SEO și AEO/GEO), serviciile înrudite și ghidul, apoi un singur îndemn.
// Șablonul nu citește colecțiile: pagina (src/pages/servicii/[slug].astro) îi dă doar ce se poate publica (§3.4).
// Fără JavaScript. Banda primește clasa `vt-<slug>` prin Base (ruling R5), pentru tranziția M3 din §5.7.
import type { CollectionEntry } from 'astro:content';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { SERVICII } from '../form-rules';
import { DRAFT } from '../lib/env';
import { nodFaq, nodService } from '../lib/jsonld';
import Base from './Base.astro';

interface Props {
  serviciu: CollectionEntry<'servicii'>['data'];
  /** Serviciile din `inrudite`, în ordinea lor, cu problema din „De unde pornești?” ca explicație. */
  inrudite: readonly { slug: string; nume: string; problema: string }[];
  /** Ghidurile legate de serviciu care se construiesc (`ghiduriDeConstruit`); de obicei niciunul sau unul. */
  ghiduri: readonly { slug: string; titlu: string }[];
  /** Proiectul din câmpul `proiect`, doar dacă e publicabil (`proiectePublicabile`). */
  proiect?: { slug: string; titlu: string; context: string } | undefined;
}

/** Textul exact din §4.4 punctul 8 și din registrul deciziilor. */
const NOTA_GARANTII = 'Nu garantez poziții în Google și nici apariții în răspunsurile motoarelor AI.';

const { serviciu: s, inrudite, ghiduri, proiect } = Astro.props;

const cale = `/servicii/${s.slug}/`;
const nume = SERVICII.find((x) => x.slug === s.slug)?.nume ?? s.titlu;
const firimituri = [
  { nume: 'Acasă', cale: '/' },
  { nume: 'Servicii', cale: '/servicii/' },
  { nume, cale },
];
---

<Base
  titlu={s.titlu}
  descriere={s.descriere}
  cale={cale}
  aprobat={s.aprobat}
  jsonld={[nodService(s), ...nodFaq(s.faq, DRAFT)]}
  firimituri={firimituri}
  harta={{ line: s.grup, tranzitie: s.slug }}
>
  <div class="contener serviciu" data-grup={s.grup}>
    <h1>{s.h1}</h1>
    <p class="serviciu__raspuns">{s.raspunsDirect}</p>

    <div class="serviciu__doua">
      <section>
        <h2>Pentru cine e</h2>
        <ul>{s.pentruCine.map((t) => <li>{t}</li>)}</ul>
      </section>
      <section>
        <h2>Semne că ai nevoie</h2>
        <ul>{s.semne.map((t) => <li>{t}</li>)}</ul>
      </section>
    </div>

    <section>
      <h2>Ce primești</h2>
      <ul>{s.livrabile.map((t) => <li>{t}</li>)}</ul>
    </section>

    <section>
      <h2>Cum se desfășoară</h2>
      <ol class="serviciu__pasi">{s.pasi.map((t) => <li>{t}</li>)}</ol>
    </section>

    {
      proiect && (
        <section>
          <h2>Un proiect</h2>
          <p class="serviciu__proiect">
            <a href={`/proiecte/${proiect.slug}/`}>{proiect.titlu}</a>
          </p>
          <p>{proiect.context}</p>
        </section>
      )
    }

    <section>
      <h2>Întrebări frecvente</h2>
      <Faq intrebari={s.faq} />
    </section>

    {s.notaGarantii && <p class="serviciu__nota">{NOTA_GARANTII}</p>}

    <section>
      <h2>Servicii înrudite</h2>
      <ul class="inrudite">
        {
          inrudite.map((i) => (
            <li>
              <a href={`/servicii/${i.slug}/`}>{i.nume}</a>
              <span class="inrudite__problema">{i.problema}</span>
            </li>
          ))
        }
      </ul>
      {
        ghiduri.map((g) => (
          <p class="serviciu__ghid">
            Citește și ghidul: <a href={`/ghiduri/${g.slug}/`}>{g.titlu}</a>
          </p>
        ))
      }
    </section>
  </div>

  <div class="indemn">
    <div class="contener indemn__rand">
      <p class="indemn__text">Spune-mi ce face firma ta și de ce ai nevoie.</p>
      <Cta />
    </div>
  </div>
</Base>

<style>
  /* Culoarea grupului (§5.2) dă doar buline și numerele pașilor: grafică cu sens, deci construcția ia galbenul închis. */
  .serviciu[data-grup='vizibilitate'] {
    --culoare: var(--blue);
  }

  .serviciu[data-grup='diagnostic'] {
    --culoare: var(--green);
  }

  .serviciu[data-grup='constructie'] {
    --culoare: var(--yellow-dark);
  }

  .serviciu[data-grup='reparatie'] {
    --culoare: var(--red);
  }

  .serviciu {
    padding-block: 1rem 3rem;
  }

  h1 {
    max-width: 22ch;
    margin-top: 0.5rem;
  }

  /* Răspunsul direct e primul paragraf, cel pe care îl citesc motoarele AI (§6.4): puțin mai mare decât restul. */
  .serviciu__raspuns {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  section {
    margin-top: 2.5rem;
  }

  /* „Pentru cine e” și „Semne că ai nevoie” stau una lângă alta pe desktop, una sub alta pe mobil. */
  .serviciu__doua {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 3rem;
  }

  @media (min-width: 48rem) {
    .serviciu__doua {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  ul,
  ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  li {
    margin-block: 0.4rem;
  }

  li::marker {
    color: var(--culoare);
    font-weight: 800;
  }

  .serviciu__proiect {
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  /* Nota despre garanții: un rând liniștit, sub întrebări, fără să pară o avertizare. */
  .serviciu__nota {
    margin-top: 1.5rem;
    color: var(--ink-2);
  }

  /* Serviciile înrudite: numele ca link, cu problema dedesubt; zona de atingere de 44px (§5.8). */
  .inrudite {
    padding: 0;
    list-style: none;
  }

  .inrudite li {
    margin-block: 0 1rem;
  }

  .inrudite a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .inrudite__problema {
    display: block;
    color: var(--ink-2);
  }

  /* Un singur îndemn (§4.4 punctul 10), pe o bandă albastru deschis: butonul albastru rămâne vizibil pe ea. */
  .indemn {
    padding-block: 2rem;
    background: var(--tint-blue);
  }

  .indemn__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .indemn__text {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.3;
  }
</style>
