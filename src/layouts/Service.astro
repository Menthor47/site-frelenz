---
// Șablonul paginii de serviciu (§4.4), același pentru toate 6. Ordinea din pagină e cea din spec:
// banda cu harta (linia grupului plină, „Ești aici”) și firimiturile, H1-ul cu cuvântul-cheie și răspunsul direct,
// „Pentru cine e” și „Semne că ai nevoie”, „Ce primești” și „Cum se desfășoară” (alăturate pe desktop; pașii desenați ca
// linia grupului, PasiTraseu), proiectul (dacă există), întrebările frecvente, nota despre garanții (doar pe SEO și
// AEO/GEO), serviciile înrudite și ghidul, apoi un singur îndemn.
// Șablonul nu citește colecțiile: pagina (src/pages/servicii/[slug].astro) îi dă doar ce se poate publica (§3.4).
// Fără JavaScript. Banda primește clasa `vt-<slug>` prin Base (ruling R5), pentru tranziția M3 din §5.7.
import type { CollectionEntry } from 'astro:content';
import FaraRupere from '../components/FaraRupere.astro';
import Indemn from '../components/Indemn.astro';
import PasiTraseu from '../components/PasiTraseu.astro';
import Faq from '../components/Faq.astro';
import TextSauMarcaj from '../components/TextSauMarcaj.astro';
import { cereServiciu } from '../form-rules';
import { DRAFT } from '../lib/env';
import { nodFaq, nodService } from '../lib/jsonld';
import { faraMarcaje, hasMarker } from '../lib/marker';
import Base from './Base.astro';

interface Props {
  serviciu: CollectionEntry<'servicii'>['data'];
  /** Serviciile din `inrudite`, în ordinea lor, cu problema din „De unde pornești?” ca explicație. */
  inrudite: readonly { slug: string; nume: string; problema: string }[];
  /** Ghidurile legate de serviciu care se construiesc (`ghiduriDeConstruit`); de obicei niciunul sau unul. */
  ghiduri: readonly { slug: string; titlu: string }[];
  /** Proiectul din câmpul `proiect`, doar dacă e publicabil (`proiectePublicabile`). */
  proiect?: { slug: string; titlu: string; context: string } | undefined;
}

/** Textul exact din §4.4 punctul 8 și din registrul deciziilor. */
const NOTA_GARANTII = 'Nu garantez poziții în Google și nici apariții în răspunsurile motoarelor AI.';

const { serviciu: s, inrudite, ghiduri, proiect } = Astro.props;

const cale = `/servicii/${s.slug}/`;
const { nume } = cereServiciu(s.slug, `servicii/${s.slug}`);
const firimituri = [
  { nume: 'Acasă', cale: '/' },
  { nume: 'Servicii', cale: '/servicii/' },
  { nume, cale },
];

// Proiectul, după regula din ProiecteRezumat (§3.4): niciun marcaj ca text brut. Un titlu încă marcaj n-ar da text
// linkului, deci în producție secțiunea lipsește; un context încă marcaj lipsește doar el. În previzualizare apar prin Placeholder.
const [proiectVizibil] = proiect === undefined ? [] : faraMarcaje([proiect], (p) => hasMarker(p.titlu), DRAFT);
const contextProiect = proiectVizibil === undefined ? undefined : faraMarcaje([proiectVizibil.context], hasMarker, DRAFT)[0];
---

<Base
  titlu={s.titlu}
  descriere={s.descriere}
  cale={cale}
  aprobat={s.aprobat}
  jsonld={[nodService(s), ...nodFaq(s.faq, DRAFT)]}
  firimituri={firimituri}
  harta={{ line: s.grup, tranzitie: s.slug }}
  suprafata={true}
>
  <div class="contener serviciu" data-grup={s.grup}>
    <h1><FaraRupere text={s.h1} /></h1>
    <p class="serviciu__raspuns"><FaraRupere text={s.raspunsDirect} /></p>

    <div class="serviciu__doua carte">
      <section>
        <h2>Pentru cine e</h2>
        <ul>{s.pentruCine.map((t) => <li><FaraRupere text={t} /></li>)}</ul>
      </section>
      <section>
        <h2>Semne că ai nevoie</h2>
        <ul>{s.semne.map((t) => <li><FaraRupere text={t} /></li>)}</ul>
      </section>
    </div>

    <div class="serviciu__pereche">
      <section class="carte">
        <h2>Ce primești</h2>
        <ul>{s.livrabile.map((t) => <li><FaraRupere text={t} /></li>)}</ul>
      </section>

      <section class="carte">
        <h2>Cum se desfășoară</h2>
        <PasiTraseu pasi={s.pasi.map((text) => ({ text }))} />
      </section>
    </div>

    {
      proiectVizibil && (
        <section class="carte">
          <h2>Un proiect</h2>
          <p class="serviciu__proiect">
            <a href={`/proiecte/${proiectVizibil.slug}/`}><TextSauMarcaj valoare={proiectVizibil.titlu} /></a>
          </p>
          {contextProiect !== undefined && (
            <p>
              <TextSauMarcaj valoare={contextProiect} />
            </p>
          )}
        </section>
      )
    }

    <section class="carte">
      <h2>Întrebări frecvente</h2>
      <Faq intrebari={s.faq} />
    </section>

    {s.notaGarantii && <p class="serviciu__nota">{NOTA_GARANTII}</p>}

    <section class="carte">
      <h2>Servicii înrudite</h2>
      <ul class="inrudite">
        {
          inrudite.map((i) => (
            <li>
              <a href={`/servicii/${i.slug}/`}>{i.nume}</a>
              <span class="inrudite__problema"><FaraRupere text={i.problema} /></span>
            </li>
          ))
        }
      </ul>
      {
        ghiduri.map((g) => (
          <p class="serviciu__ghid">
            Citește și ghidul: <a href={`/ghiduri/${g.slug}/`}>{g.titlu}</a>
          </p>
        ))
      }
    </section>
  </div>

  <Indemn text="Spune-mi ce face firma ta și de ce ai nevoie." />
</Base>

<style>
  /* Culoarea grupului vine din `data-grup` (tokens.css): `--culoare` dă bulinele listelor și linia pașilor (PasiTraseu). */
  .serviciu {
    padding-block: 1rem 3rem;
  }

  h1 {
    max-width: 22ch;
    margin-top: 0.5rem;
  }

  /* Răspunsul direct e primul paragraf, cel pe care îl citesc motoarele AI (§6.4): puțin mai mare decât restul. */
  .serviciu__raspuns {
    font-size: var(--text-md);
    line-height: 1.45;
  }

  /* Cardurile stau la 1,5rem unul de altul. „Pentru cine e” și „Semne că ai nevoie” sunt un singur card, deci spațiul
     dintre ele e în card. */
  .serviciu > .carte,
  .serviciu__pereche {
    margin-top: 1.5rem;
  }

  /* „Ce primești” și „Cum se desfășoară” au aceeași greutate (5–6 rânduri fiecare): de la 64rem stau alături, la aceeași
     înălțime, fiecare cu textul la măsura lui (34em), în loc de două carduri late, pe jumătate goale. */
  .serviciu__pereche {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .serviciu__pereche {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* „Pentru cine e” și „Semne că ai nevoie” stau într-un singur card: una lângă alta pe desktop, cu 3rem între coloane,
     și una sub alta pe mobil, cu 2,5rem între rânduri. */
  .serviciu__doua {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2.5rem;
    column-gap: 3rem;
  }

  @media (min-width: 48rem) {
    .serviciu__doua {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  ul,
  ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  li {
    margin-block: 0.4rem;
  }

  li::marker {
    color: var(--culoare);
    font-weight: 800;
  }

  .serviciu__proiect {
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  /* Nota despre garanții: un rând liniștit, sub întrebări, fără să pară o avertizare. */
  .serviciu__nota {
    margin-top: 1.5rem;
    color: var(--ink-2);
  }

  /* Serviciile înrudite: numele ca link, cu problema dedesubt; zona de atingere de 44px (§5.8). */
  .inrudite {
    padding: 0;
    list-style: none;
  }

  .inrudite li {
    margin-block: 0 1rem;
  }

  .inrudite a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .inrudite__problema {
    display: block;
    color: var(--ink-2);
  }
</style>
