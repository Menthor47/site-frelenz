---
// Layout-ul paginilor, în afară de Acasă: Schelet.astro (head, antet, <main>, subsol), plus banda cu harta și firimiturile, la
// începutul lui <main>. Acasă folosește direct Schelet.astro: n-are nici bandă, nici firimituri, iar așa nu primește CSS-ul
// firimiturilor (linie-statii.css și stilurile din Breadcrumbs.astro; Astro adună CSS-ul tuturor componentelor importate, chiar
// dacă nu se randează), pentru limita de 25 KB de CSS pe pagină (§9.1 „Bugete” din spec-ul principal; spec-ul metroul
// îmbunătățit, nota de la început).
// Regulile benzii sunt în metro.css, care ajunge pe toate paginile, deci Acasă le primește oricum.
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MetroMap from '../components/MetroMap.astro';
import type { Grup } from '../form-rules';
import type { PasFirimitura } from '../lib/jsonld';
import Schelet, { type Props as PropsSchelet } from './Schelet.astro';

interface Props extends Omit<PropsSchelet, 'tintaSubBanda'> {
  /** Pașii de la Acasă până la pagina curentă. Se văd ca firimituri și intră în JSON-LD ca `BreadcrumbList`. Paginile fără firimituri nu îl dau. */
  firimituri?: PasFirimitura[];
  /**
   * Banda de sus cu harta de metrou (§4.4, §5.6), deasupra firimiturilor, cu trenuri și butonul „Oprește trenurile”, ca pe
   * Acasă. Cu `line`, linia grupului e plină și are „Ești aici”; fără, toate liniile sunt la fel de estompate. Paginile fără
   * hartă (legale, 404, răspunsurile formularului) nu o dau. Acasă nu folosește Base: își pune harta animată în zona ei de sus.
   * Sub 48rem banda se ascunde (metro.css), iar firimiturile devin linia de metrou în culoarea grupului: `line` ajunge ca
   * `data-grup` pe containerul lor (Breadcrumbs.astro, linie-statii.css).
   * `tranzitie` e slug-ul serviciului: banda primește clasa `vt-<slug>`, aceeași ca segmentul din „De unde pornești?”,
   * iar src/styles/transitions.css le dă același `view-transition-name` (M3 din §5.7, ruling R5).
   */
  harta?: { line?: Grup | undefined; tranzitie?: string | undefined };
}

const { firimituri = [], harta, ...rest } = Astro.props;

// „Sari la conținut” trece peste banda decorativă și butonul ei de oprire: cu bandă și firimituri, ținta e firimiturile
// (A-05 din auditul din 2026-10-24). Altfel, ținta rămâne <main> (Schelet.astro).
const tintaSubBanda = harta !== undefined && firimituri.length > 0;
---

<Schelet {...rest} firimituri={firimituri} tintaSubBanda={tintaSubBanda}>
  <Fragment slot="inceput">
    {
      harta && (
        <div class:list={['banda', harta.tranzitie !== undefined && `vt-${harta.tranzitie}`]}>
          <MetroMap variant="banda" line={harta.line} />
        </div>
      )
    }
    {
      firimituri.length > 0 && (
        <div class="contener" id={tintaSubBanda ? 'continut' : undefined} tabindex={tintaSubBanda ? '-1' : undefined} data-grup={harta?.line}>
          <Breadcrumbs pasi={firimituri} />
        </div>
      )
    }
  </Fragment>
  <slot />
</Schelet>
