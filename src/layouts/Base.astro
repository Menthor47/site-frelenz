---
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import MetroMap from '../components/MetroMap.astro';
import SeoHead from '../components/SeoHead.astro';
import type { Grup } from '../form-rules';
import { DRAFT } from '../lib/env';
import { noduriPagina, type PasFirimitura } from '../lib/jsonld';
import { areProiecte, ghiduriDeConstruit, proiectePublicabile } from '../lib/publish';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/butoane.css';
import '../styles/transitions.css';

interface Props {
  /** Titlul paginii, fără sufixul „ – Alex Ionescu” (îl adaugă `SeoHead`, dacă încape în 60 de caractere). */
  titlu: string;
  descriere: string;
  /** Calea paginii, cu slash la început și la sfârșit (ex. `/servicii/`). Din ea se face canonical-ul. */
  cale: string;
  /** Aprobarea lui Alex pentru textul paginii. Nu ajunge în HTML: `check:launch` o citește din `src/approvals.ts` și din frontmatter. */
  aprobat: boolean;
  noindex?: boolean;
  /** Ghidurile și studiile de caz (`Article` în JSON-LD): Open Graph le dă `og:type` „article”. */
  articol?: boolean;
  /** Nodurile JSON-LD ale paginii; `WebSite` și `Person` minimal se adaugă singure (vezi `JsonLd`). */
  jsonld?: object[];
  /** Pașii de la Acasă până la pagina curentă. Se văd ca firimituri și intră în JSON-LD ca `BreadcrumbList`. Acasă și paginile fără firimituri nu îl dau. */
  firimituri?: PasFirimitura[];
  /**
   * Banda de sus cu harta de metrou (§4.4, §5.6), deasupra firimiturilor, cu trenuri și butonul „Oprește trenurile”, ca pe
   * Acasă. Cu `line`, linia grupului e plină și are „Ești aici”; fără, toate liniile sunt la fel de estompate. Paginile fără
   * hartă (legale, 404, răspunsurile formularului) nu o dau. Acasă nu o dă nici ea: își pune harta animată în zona ei de sus.
   * `tranzitie` e slug-ul serviciului: banda primește clasa `vt-<slug>`, aceeași ca segmentul din „De unde pornești?”,
   * iar src/styles/transitions.css le dă același `view-transition-name` (M3 din §5.7, ruling R5).
   */
  harta?: { line?: Grup | undefined; tranzitie?: string | undefined };
  /** Fundalul deschis al conținutului de sub bandă (`.main--suprafata`), pe care stau cardurile `.carte`. Îl dau Acasă și toate paginile publice cu bandă (servicii, Cum lucrez, Despre, Contact, Proiecte, Ghiduri); cele legale, 404, răspunsurile formularului și paginile interne de test nu. */
  suprafata?: boolean;
}

const { titlu, descriere, cale, noindex = false, articol = false, jsonld = [], firimituri = [], harta, suprafata = false } = Astro.props;

// Ce secțiuni există în producție (§3.4). Antetul și subsolul primesc doar rezultatul, nu colecțiile.
const proiecte = (await getCollection('proiecte')).map((intrare) => intrare.data);
const ghiduri = (await getCollection('ghiduri')).map((intrare) => intrare.data);
const arataProiecte = areProiecte(proiecte, DRAFT);
const arataGhiduri = ghiduriDeConstruit(ghiduri, DRAFT).length > 0;
const arataAcestSite = proiectePublicabile(proiecte, DRAFT).some((proiect) => proiect.slug === 'acest-site');

const noduri = noduriPagina(jsonld, firimituri);

// „Sari la conținut” trece peste banda decorativă și butonul ei de oprire: cu bandă și firimituri, ținta e firimiturile
// (A-05 din auditul din 2026-10-24). Altfel, ținta rămâne <main>.
const tintaSubBanda = harta !== undefined && firimituri.length > 0;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <SeoHead titlu={titlu} descriere={descriere} cale={cale} noindex={noindex} articol={articol} />
    {/* Favicon: stația plină albastră, ca „Ești aici” (§5.4, ruling R14). favicon.svg e iconița principală; PNG-ul de 96×96
        e pentru programele care nu citesc SVG, iar iconița Apple, pentru ecranul de start al iPhone-ului (src/lib/iconite.ts).
        Comentariu JSX, nu HTML: nu ajunge în paginile construite (A-18 din auditul din 2026-10-24). */}
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <JsonLd noduri={noduri} />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="sari" href="#continut">Sari la conținut</a>
    <Header cale={cale} arataProiecte={arataProiecte} arataGhiduri={arataGhiduri} />
    <main id={tintaSubBanda ? undefined : 'continut'} tabindex={tintaSubBanda ? undefined : '-1'} class:list={[suprafata && 'main--suprafata']}>
      {
        harta && (
          <div class:list={['banda', harta.tranzitie !== undefined && `vt-${harta.tranzitie}`]}>
            <MetroMap variant="banda" line={harta.line} />
          </div>
        )
      }
      {
        firimituri.length > 0 && (
          <div class="contener" id={tintaSubBanda ? 'continut' : undefined} tabindex={tintaSubBanda ? '-1' : undefined}>
            <Breadcrumbs pasi={firimituri} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer arataAcestSite={arataAcestSite} arataProiecte={arataProiecte} />
  </body>
</html>
