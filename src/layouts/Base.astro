---
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import MetroMap from '../components/MetroMap.astro';
import SeoHead from '../components/SeoHead.astro';
import type { Grup } from '../form-rules';
import { DRAFT } from '../lib/env';
import { nodBreadcrumb, type PasFirimitura } from '../lib/jsonld';
import { areProiecte, ghiduriDeConstruit, proiectePublicabile } from '../lib/publish';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/butoane.css';
import '../styles/transitions.css';

interface Props {
  /** Titlul paginii, fără sufixul „ – Alex Ionescu” (îl adaugă `SeoHead`, dacă încape în 60 de caractere). */
  titlu: string;
  descriere: string;
  /** Calea paginii, cu slash la început și la sfârșit (ex. `/servicii/`). Din ea se face canonical-ul. */
  cale: string;
  /** Aprobarea lui Alex pentru textul paginii. Nu ajunge în HTML: `check:launch` o citește din `src/approvals.ts` și din frontmatter. */
  aprobat: boolean;
  noindex?: boolean;
  /** Nodurile JSON-LD ale paginii; `WebSite` și `Person` minimal se adaugă singure (vezi `JsonLd`). */
  jsonld?: object[];
  /** Pașii de la Acasă până la pagina curentă. Se văd ca firimituri și intră în JSON-LD ca `BreadcrumbList`. Acasă și paginile fără firimituri nu îl dau. */
  firimituri?: PasFirimitura[];
  /**
   * Banda de sus cu harta de metrou statică (§4.4, §5.6), deasupra firimiturilor. Cu `line`, linia grupului e plină și are
   * „Ești aici”; fără, toate liniile sunt la fel de estompate. Paginile fără hartă (legale, 404, răspunsurile formularului)
   * nu o dau. Harta animată nu vine de aici: Acasă o pune în zona ei de sus.
   * `tranzitie` e slug-ul serviciului: banda primește clasa `vt-<slug>`, aceeași ca segmentul din „De unde pornești?”,
   * iar src/styles/transitions.css le dă același `view-transition-name` (M3 din §5.7, ruling R5).
   */
  harta?: { line?: Grup | undefined; tranzitie?: string | undefined };
}

const { titlu, descriere, cale, noindex = false, jsonld = [], firimituri = [], harta } = Astro.props;

// Ce secțiuni există în producție (§3.4). Antetul și subsolul primesc doar rezultatul, nu colecțiile.
const proiecte = (await getCollection('proiecte')).map((intrare) => intrare.data);
const ghiduri = (await getCollection('ghiduri')).map((intrare) => intrare.data);
const arataProiecte = areProiecte(proiecte, DRAFT);
const arataGhiduri = ghiduriDeConstruit(ghiduri, DRAFT).length > 0;
const arataAcestSite = proiectePublicabile(proiecte, DRAFT).some((proiect) => proiect.slug === 'acest-site');

const noduri = firimituri.length > 0 ? [...jsonld, nodBreadcrumb(firimituri)] : jsonld;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <SeoHead titlu={titlu} descriere={descriere} cale={cale} noindex={noindex} />
    <!-- Favicon: stația plină albastră, ca „Ești aici” (§5.4, ruling R14). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <JsonLd noduri={noduri} />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="sari" href="#continut">Sari la conținut</a>
    <Header cale={cale} arataProiecte={arataProiecte} arataGhiduri={arataGhiduri} />
    <main id="continut" tabindex="-1">
      {
        harta && (
          <div class:list={['banda', harta.tranzitie !== undefined && `vt-${harta.tranzitie}`]}>
            <MetroMap variant="static" line={harta.line} />
          </div>
        )
      }
      {
        firimituri.length > 0 && (
          <div class="contener">
            <Breadcrumbs pasi={firimituri} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer arataAcestSite={arataAcestSite} arataProiecte={arataProiecte} />
  </body>
</html>
