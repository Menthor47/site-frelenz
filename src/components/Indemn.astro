---
// Banda cu îndemnul final (§4.4 punctul 10): o frază și butonul „Cere o ofertă”, pe albastru deschis, ca butonul albastru
// să rămână vizibil pe ea. O folosesc paginile de serviciu, Cum lucrez, Despre, listele de Proiecte și de Ghiduri,
// studiile de caz și ghidurile; Acasă are banda ei, albastră plină (§4.3 punctul 7).
import Cta from './Cta.astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="indemn">
  <div class="contener indemn__rand">
    <p class="indemn__text">{text}</p>
    <Cta />
  </div>
</div>

<style>
  .indemn {
    padding-block: 2rem;
    /* Albastrul benzii de trasee (decizia 26): se vede pe suprafața paginii (1,10:1), pe care --tint-blue (1,02:1) se pierde. */
    background: var(--albastru-benzi);
  }

  .indemn__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .indemn__text {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.3;
  }
</style>
