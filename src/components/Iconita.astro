---
// Iconițele (§5.4): puține, SVG inline, doar unde au sens: eroare, telefon, WhatsApp și e-mail. Sunt desene, deci
// `aria-hidden`: numele îl dă textul de lângă ele. Linii de 2 pe o grilă de 24, cu colțuri drepte ca restul site-ului
// (§5.8), în culoarea textului (`currentColor`). Telefonul e un telefon mobil, WhatsApp un balon de mesaj generic (nu
// logo-ul aplicației), e-mailul un plic, eroarea un triunghi cu semnul exclamării.
interface Props {
  nume: 'eroare' | 'telefon' | 'whatsapp' | 'email';
}

const { nume } = Astro.props;

/** Desenul fiecărei iconițe: traseele SVG, pe grila de 24×24. */
const DESENE: Readonly<Record<Props['nume'], readonly string[]>> = {
  eroare: ['M12 3 22 21H2Z', 'M12 9v5', 'M12 17v1'],
  telefon: ['M7 2h10v20H7Z', 'M11 18h2'],
  whatsapp: ['M3 4h18v13H9l-6 4Z'],
  email: ['M3 5h18v14H3Z', 'm3 5 9 7 9-7'],
};
---

<svg class="iconita" viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-iconita={nume}>
  {DESENE[nume].map((d) => <path d={d} />)}
</svg>

<style>
  /* Mărimea urmează textul: 1,25em lângă textul de bază; titlurile o pot micșora din pagină. */
  .iconita {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
</style>
