---
// Harta de metrou (§5.6), semnătura vizuală a site-ului: patru linii în culorile grupurilor, la 45°, cu stații albe conturate.
// - `static` (banda de sus a paginilor, prin `Base`): linia grupului `line` e plină și are „Ești aici”, celelalte sunt
//   estompate; fără `line`, toate sunt la fel de estompate. Fără JavaScript.
// - `animated` (doar pe Acasă, în zona de sus): liniile se desenează o dată, apoi circulă câte un tren pe fiecare linie.
//   Trenurile și butonul de oprire apar doar după ce pornește scriptul (src/client/trains.ts).
// Desenul e decorativ (`aria-hidden`); butonul stă în afara SVG-ului, ca să rămână în arborele de accesibilitate.
// Culorile vin din metro.css, prin `data-linie` (CSP: fără atribute `style`). Rădăcina are clasa `harta` (ruling R2).
import type { Grup } from '../form-rules';
import '../styles/metro.css';

interface Props {
  variant: 'animated' | 'static';
  /** Doar pe harta statică: grupul paginii. Linia lui e plină și are marcajul „Ești aici”. */
  line?: Grup | undefined;
}

type Linie = 'M1' | 'M2' | 'M3' | 'M4';

/** Grupurile pe linii (§5.1): construcție M1 galben, vizibilitate M2 albastru, reparație M3 roșu, diagnostic M4 verde. */
const LINIA_GRUPULUI: Readonly<Record<Grup, Linie>> = {
  constructie: 'M1',
  vizibilitate: 'M2',
  reparatie: 'M3',
  diagnostic: 'M4',
};

interface Traseu {
  readonly linie: Linie;
  /** Doar segmente orizontale și la 45°, în unitățile desenului (1200×240). */
  readonly d: string;
  readonly statii: readonly (readonly [number, number])[];
  /** Stația pe care stă „Ești aici”. E în mijlocul desenului, ca să se vadă și la 320px (x între 333 și 867). */
  readonly aici: readonly [number, number];
  /** Eticheta stă deasupra stației sau dedesubt, unde nu calcă pe altă linie. */
  readonly eticheta: 'sus' | 'jos';
  /** Secundele unui drum dintr-un capăt în celălalt (§5.6: 7–11) și locul din tur de unde pleacă trenul (0–1). */
  readonly tren: { readonly drum: number; readonly plecare: number };
}

// Liniile se împletesc: la stânga, de sus în jos, M1, M2, M3, M4; la dreapta, invers. Se schimbă la 45°,
// iar unde se întâlnesc pe M2 au stații de corespondență (400, 640 și 840).
// Ordinea e și ordinea desenării: M2 trece pe deasupra.
const TRASEE: readonly Traseu[] = [
  {
    linie: 'M1',
    d: 'M100 40H560L680 160H1160',
    statii: [[200, 40], [330, 40], [460, 40], [640, 120], [960, 160], [1090, 160]],
    aici: [460, 40],
    eticheta: 'sus',
    tren: { drum: 9, plecare: 0.15 },
  },
  {
    linie: 'M3',
    d: 'M40 160H360L440 80H1120',
    statii: [[130, 160], [260, 160], [400, 120], [520, 80], [700, 80], [1000, 80]],
    aici: [700, 80],
    eticheta: 'sus',
    tren: { drum: 10, plecare: 0.35 },
  },
  {
    linie: 'M4',
    d: 'M160 200H760L920 40H1140',
    statii: [[260, 200], [420, 200], [600, 200], [840, 120], [1040, 40]],
    aici: [600, 200],
    eticheta: 'sus',
    tren: { drum: 11, plecare: 0.8 },
  },
  {
    linie: 'M2',
    d: 'M40 120H1160',
    statii: [[130, 120], [260, 120], [400, 120], [520, 120], [640, 120], [840, 120], [990, 120], [1110, 120]],
    aici: [520, 120],
    eticheta: 'jos',
    tren: { drum: 8, plecare: 0.6 },
  },
];

const rotunjit = (n: number) => String(Math.round(n * 1000) / 1000);

/**
 * Mersul unui tren care face naveta între capete, cu viteză constantă: un tur e dus-întors, deci durează două drumuri.
 * `plecare` e locul din tur de unde pornește trenul, ca trenurile să nu meargă în pas: 0 e primul capăt, 0,5 celălalt.
 * Se alege strict între ele (nu 0 sau 0,5), altfel două momente cheie ar cădea în același loc.
 */
function mers({ drum, plecare: p }: Traseu['tren']) {
  const [puncte, momente] =
    p < 0.5
      ? [[2 * p, 1, 0, 2 * p], [0, 0.5 - p, 1 - p, 1]]
      : [[2 - 2 * p, 0, 1, 2 - 2 * p], [0, 1 - p, 1.5 - p, 1]];
  return { dur: `${2 * drum}s`, keyPoints: puncte.map(rotunjit).join(';'), keyTimes: momente.map(rotunjit).join(';') };
}

const { variant, line } = Astro.props;
const animata = variant === 'animated';
const plina = !animata && line !== undefined ? LINIA_GRUPULUI[line] : undefined;
// Linia plină se desenează ultima, deasupra celor estompate.
const ordine = [...TRASEE.filter((t) => t.linie !== plina), ...TRASEE.filter((t) => t.linie === plina)];
---

<div class:list={['harta', animata ? 'harta--animata' : 'harta--statica']}>
  <svg class="harta__desen" viewBox="0 0 1200 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {
      ordine.map((t) => (
        <g class="harta__linie" data-linie={t.linie} data-plina={t.linie === plina ? '' : undefined}>
          <path class="harta__traseu" d={t.d} pathLength="1" />
          {t.statii.map(([x, y]) => (
            <circle class="harta__statie" cx={x} cy={y} r="8" />
          ))}
          {t.linie === plina && (
            <>
              <circle class="harta__aici" cx={t.aici[0]} cy={t.aici[1]} r="13" />
              <text class="harta__eticheta" x={t.aici[0] + 18} y={t.eticheta === 'sus' ? t.aici[1] - 16 : t.aici[1] + 36}>Ești aici</text>
            </>
          )}
        </g>
      ))
    }
    {
      animata && (
        <g class="trenuri">
          {TRASEE.map((t) => (
            <g class="tren" data-linie={t.linie}>
              <circle class="tren__halou" r="17" />
              <circle class="tren__miez" r="6" />
              <animateMotion path={t.d} begin="indefinite" repeatCount="indefinite" calcMode="linear" {...mers(t.tren)} />
            </g>
          ))}
        </g>
      )
    }
  </svg>
  {animata && <button type="button" class="harta__buton" hidden>Oprește trenurile</button>}
  {animata && <p class="harta__anunt" aria-live="polite" data-stare-trenuri />}
</div>

{
  animata && (
    <script>
      import { initTrains } from '../client/trains';

      for (const harta of document.querySelectorAll<HTMLElement>('.harta--animata')) initTrains(harta);
    </script>
  )
}
