---
// Harta de metrou (§5.6), semnătura vizuală a site-ului: patru linii în culorile grupurilor, la 45°, pe fundal întunecat,
// cu stații luminate (miez întunecat, contur deschis).
// - `banda` (banda de sus a paginilor, prin `Base`): cu trenuri și buton de oprire, ca pe Acasă. Linia grupului `line` e
//   plină și are „Ești aici”, celelalte sunt estompate; fără `line`, toate sunt la fel de estompate.
// - `animated` (doar pe Acasă, în zona de sus): liniile se desenează o dată, apoi circulă câte un tren pe fiecare linie.
//   Fără „Ești aici”.
// - `static` (nu o folosește nicio pagină publică, doar pagina internă /_test/harta/): ca banda, dar fără trenuri,
//   fără buton și fără script.
// Trenurile și butonul de oprire apar doar după ce pornește scriptul (src/client/trains.ts).
// Desenul e decorativ (`aria-hidden`); butonul stă în afara SVG-ului, ca să rămână în arborele de accesibilitate.
// Culorile vin din metro.css, prin `data-linie` (CSP: fără atribute `style`). Rădăcina are clasa `harta` (ruling R2).
// Traseele stau în src/lib/harta.ts, pe care îl folosesc și imaginile Open Graph.
import type { Grup } from '../form-rules';
import { LINIA_GRUPULUI, ordineaDesenarii, TRASEE, type Traseu } from '../lib/harta';
import '../styles/metro.css';

interface Props {
  /** `animated`: harta de pe Acasă. `banda`: banda de sus a paginilor, cu trenuri ca Acasă (decizia din 2026-10-23). `static`: fără trenuri. */
  variant: 'animated' | 'banda' | 'static';
  /** Pe bandă și pe harta statică: grupul paginii. Linia lui e plină și are marcajul „Ești aici”. */
  line?: Grup | undefined;
}

const rotunjit = (n: number) => String(Math.round(n * 1000) / 1000);

/**
 * Mersul unui tren care face naveta între capete, cu viteză constantă: un tur e dus-întors, deci durează două drumuri.
 * `plecare` e locul din tur de unde pornește trenul, ca trenurile să nu meargă în pas: 0 e primul capăt, 0,5 celălalt.
 * Se alege strict între ele (nu 0 sau 0,5), altfel două momente cheie ar cădea în același loc.
 */
function mers({ drum, plecare: p }: Traseu['tren']) {
  const [puncte, momente] =
    p < 0.5
      ? [[2 * p, 1, 0, 2 * p], [0, 0.5 - p, 1 - p, 1]]
      : [[2 - 2 * p, 0, 1, 2 - 2 * p], [0, 1 - p, 1.5 - p, 1]];
  return { dur: `${2 * drum}s`, keyPoints: puncte.map(rotunjit).join(';'), keyTimes: momente.map(rotunjit).join(';') };
}

const { variant, line } = Astro.props;
// Trenurile, butonul de oprire și scriptul sunt pe Acasă și pe banda de sus a tuturor paginilor (WCAG 2.2.2 cere oprire).
const cuTrenuri = variant === 'animated' || variant === 'banda';
const plina = variant !== 'animated' && line !== undefined ? LINIA_GRUPULUI[line] : undefined;
const ordine = ordineaDesenarii(plina);
---

<div class:list={['harta', 'harta--noapte', cuTrenuri ? 'harta--animata' : 'harta--statica', variant === 'banda' && 'harta--banda', variant === 'animated' && 'harta--pe-acasa', plina !== undefined && 'harta--cu-linie']}>
  <svg class="harta__desen" viewBox="0 0 1200 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {
      ordine.map((t) => (
        <g class="harta__linie" data-linie={t.linie} data-plina={t.linie === plina ? '' : undefined}>
          <path class="harta__traseu" d={t.d} pathLength="1" />
          {t.statii.map(([x, y]) => (
            <circle class="harta__statie" cx={x} cy={y} r="8" />
          ))}
          {t.linie === plina && (
            <>
              <circle class="harta__aici" cx={t.aici[0]} cy={t.aici[1]} r="13" />
              <text class="harta__eticheta" x={t.aici[0] + 18} y={t.eticheta === 'sus' ? t.aici[1] - 16 : t.aici[1] + 36}>Ești aici</text>
            </>
          )}
        </g>
      ))
    }
    {
      cuTrenuri && (
        <g class="trenuri">
          {TRASEE.map((t) => (
            <g class="tren" data-linie={t.linie}>
              <circle class="tren__halou" r="17" />
              <circle class="tren__miez" r="6" />
              <animateMotion path={t.d} begin="indefinite" repeatCount="indefinite" calcMode="linear" {...mers(t.tren)} />
            </g>
          ))}
        </g>
      )
    }
  </svg>
  {cuTrenuri && <button type="button" class="harta__buton" hidden>Oprește trenurile</button>}
  {cuTrenuri && <p class="harta__anunt" aria-live="polite" data-stare-trenuri />}
</div>

{
  cuTrenuri && (
    <script>
      import { initTrains } from '../client/trains';

      for (const harta of document.querySelectorAll<HTMLElement>('.harta--animata')) initTrains(harta);
    </script>
  )
}
