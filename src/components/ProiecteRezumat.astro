---
// Proiectele pe scurt (§4.3 punctul 5): titlul ca link, contextul, ce am făcut și rezultatul, cu sursa și data.
// Pagina îi dă doar proiectele publicabile (`proiectePublicabile`) și decide câte. Niciun câmp cu marcaj [DE COMPLETAT]
// nu se scrie ca text brut (§3.4): în previzualizare trece prin `Placeholder`, iar în producție câmpul lipsește cu tot cu
// elementul lui (paragraf, rând de listă), ca la `Faq`. Un rezultat cu marcaj nu e verificabil, deci rândul lui lipsește;
// un proiect al cărui titlu e încă marcaj nu apare deloc, pentru că linkul n-ar avea text.
import { DRAFT } from '../lib/env';
import { hasMarker } from '../lib/marker';
import TextSauMarcaj from './TextSauMarcaj.astro';

interface Props {
  proiecte: readonly {
    slug: string;
    titlu: string;
    context: string;
    ceAmFacut: readonly string[];
    rezultate: readonly { text: string; sursa: string; data: Date }[];
  }[];
  /** Nivelul titlului fiecărui proiect: 3 sub un H2 „Proiecte” (Acasă), 2 direct sub H1 (/proiecte/). */
  nivelTitlu?: 2 | 3;
}

const { proiecte, nivelTitlu = 3 } = Astro.props;
const Titlu = nivelTitlu === 2 ? 'h2' : 'h3';

/** Luna și anul rezultatului. `z.coerce.date()` dă miezul nopții UTC, deci luna se citește în UTC. */
const luna = (data: Date) => data.toLocaleDateString('ro-RO', { month: 'long', year: 'numeric', timeZone: 'UTC' });

/** În producție rămân doar valorile fără marcaj; în previzualizare rămân toate, iar marcajul se vede. */
const deArata = <T,>(lista: readonly T[], areMarcaj: (x: T) => boolean): readonly T[] => (DRAFT ? lista : lista.filter((x) => !areMarcaj(x)));

const vizibile = deArata(proiecte, (p) => hasMarker(p.titlu)).map((p) => ({
  ...p,
  context: deArata([p.context], hasMarker)[0],
  ceAmFacut: deArata(p.ceAmFacut, hasMarker),
  rezultat: deArata(p.rezultate, (r) => hasMarker(r.text) || hasMarker(r.sursa))[0],
}));
---

<ul class="proiecte">
  {
    vizibile.map((p) => (
      <li>
        <Titlu>
          <a href={`/proiecte/${p.slug}/`}><TextSauMarcaj valoare={p.titlu} /></a>
        </Titlu>
        {
          p.context !== undefined && (
            <p>
              <TextSauMarcaj valoare={p.context} />
            </p>
          )
        }
        {
          p.ceAmFacut.length > 0 && (
            <ul>
              {p.ceAmFacut.map((t) => (
                <li>
                  <TextSauMarcaj valoare={t} />
                </li>
              ))}
            </ul>
          )
        }
        {
          p.rezultat && (
            <p class="proiecte__rezultat">
              <TextSauMarcaj valoare={p.rezultat.text} /> (<TextSauMarcaj valoare={p.rezultat.sursa} />, {luna(p.rezultat.data)})
            </p>
          )
        }
      </li>
    ))
  }
</ul>

<style>
  .proiecte {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proiecte > li + li {
    margin-top: 2rem;
  }

  .proiecte__rezultat {
    font-weight: 700;
  }
</style>
