---
// Etichetele din <head> care țin de indexare și de partajare (§4.2, §6.1, §6.2).
// `lang="ro"` stă pe <html>, în Base. Imaginea OG (1200×630) o generează src/pages/og/[...cale].png.ts.
import { ogPentru } from '../lib/routes';
import { titluPagina } from '../lib/seo';
import { site } from '../site.config';

interface Props {
  /** Titlul paginii, fără sufix: „ – Alex Ionescu” se adaugă doar dacă totalul are cel mult 60 de caractere. */
  titlu: string;
  /** 140–160 de caractere, unică pe pagină. */
  descriere: string;
  /** Calea paginii, cu slash la început și la sfârșit (ex. `/servicii/`). Din ea se face canonical-ul absolut. */
  cale: string;
  noindex?: boolean;
}

const { titlu, descriere, cale, noindex = false } = Astro.props;
const titluComplet = titluPagina(titlu);
const canonical = new URL(cale, site.url).href;
// Paginile interne de test (/_test/…, doar în DRAFT=1) nu sunt în src/lib/routes.ts, deci n-au imagine OG.
const imagine = cale.startsWith('/_test/') ? undefined : new URL(ogPentru(cale), site.url).href;
---

<title>{titluComplet}</title>
<meta name="description" content={descriere} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:title" content={titluComplet} />
<meta property="og:description" content={descriere} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ro_RO" />
<meta property="og:site_name" content={site.nume} />
{
  imagine !== undefined && (
    <>
      <meta property="og:image" content={imagine} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={titluComplet} />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  )
}
