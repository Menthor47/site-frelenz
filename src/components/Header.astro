---
// Antetul (§3.3, §4.3 punctul 1, §5.4): logo, meniu și butonul „Cere o ofertă”.
// Butonul lipsește pe Acasă (acolo butonul plin e sub titlu), pe /contact/ (ar trimite la aceeași pagină) și pe paginile de
// răspuns ale formularului, /contact/…/: pe cele de eroare, fără JavaScript, ar deschide un formular gol în locul butonului
// Înapoi, care readuce mesajul; pe „Am primit cererea ta” ar sugera că cererea nu s-a încheiat.
// „Contact” rămâne în meniu, în afară de ecranele sub 360px pe paginile cu buton (butonul duce la aceeași pagină). Pe telefon,
// pe paginile cu buton, butonul stă lângă logo (regulile de la sfârșit). Componenta nu citește colecțiile: Base îi spune dacă
// Proiecte și Ghiduri există (§3.4); cu ele, meniul are șase linkuri și pe telefon trece pe al doilea rând.
import { site } from '../site.config';
import Cta from './Cta.astro';

interface Props {
  /** Calea paginii, cu slash la început și la sfârșit (ex. `/servicii/seo/`). */
  cale: string;
  /** Există cel puțin un proiect publicabil. */
  arataProiecte?: boolean;
  /** Există ghiduri de construit (cel puțin 2 aprobate). */
  arataGhiduri?: boolean;
}

const { cale, arataProiecte = false, arataGhiduri = false } = Astro.props;

const meniu = [
  { href: '/servicii/', text: 'Servicii', arata: true },
  { href: '/cum-lucrez/', text: 'Cum lucrez', arata: true },
  { href: '/proiecte/', text: 'Proiecte', arata: arataProiecte },
  { href: '/ghiduri/', text: 'Ghiduri', arata: arataGhiduri },
  { href: '/despre/', text: 'Despre', arata: true },
  { href: '/contact/', text: 'Contact', arata: true },
].filter((element) => element.arata);

/** „page” pe pagina curentă, „true” pe secțiunea din care face parte (ex. Servicii pe /servicii/seo/). */
const curent = (href: string) => (cale === href ? 'page' : cale.startsWith(href) ? 'true' : undefined);

const faraButon = cale === '/' || cale.startsWith('/contact/');
---

<header class="antet">
  <div class:list={['contener', 'antet__rand', !faraButon && 'antet__rand--cu-buton']}>
    <a class="logo" href="/" aria-current={cale === '/' ? 'page' : undefined}><span class="logo__nume">{site.nume}</span><span class="logo__virgula">,</span> <span class="logo__rol">{site.logoScurt}</span></a>
    <nav aria-label="Meniu principal">
      <ul class="meniu">
        {
          meniu.map((element) => (
            <li class:list={[element.href === '/contact/' && !faraButon && 'meniu__dublat']}>
              <a href={element.href} aria-current={curent(element.href)}>{element.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {!faraButon && <Cta />}
  </div>
</header>

<style>
  /* Antetul e întunecat pe toate paginile (decizia din 2026-10-23), ca banda de sub el: aceleași culori ca harta. */
  .antet {
    background: var(--noapte);
    border-bottom: 1px solid var(--noapte-contur);
  }

  /* Ordinea din DOM (logo, meniu, buton) e și ordinea vizuală, cu o excepție pe telefon (regula de la sfârșit): acolo
     butonul stă lângă logo, iar ordinea focusului rămâne logo, meniu, buton. */
  .antet__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding-block: 0.5rem;
  }

  /* Logo (§5.4), pe antetul întunecat: „Alex Ionescu” 800 în alb, virgula în --blue, „consultant SEO” 400 în --noapte-text-2. */
  .logo {
    margin-inline-end: auto;
    /* Zona de atingere de 44px (§5.8), fără flex: spațiul dintre cele trei texte trebuie să rămână. */
    padding-block: 0.6875rem;
    color: var(--paper);
    font-size: var(--text-base);
    line-height: 1.3;
    text-decoration: none;
  }

  .logo__nume {
    font-weight: 800;
  }

  .logo__virgula {
    color: var(--blue);
    font-weight: 800;
  }

  .logo__rol {
    display: inline-block;
    color: var(--noapte-text-2);
    font-weight: 400;
  }

  /* Sub 380px, „consultant SEO” trece pe rândul următor. */
  @media (max-width: 379.98px) {
    .logo__rol {
      display: block;
    }
  }

  @media (min-width: 48rem) {
    .logo {
      font-size: var(--text-md);
    }
  }

  .meniu {
    display: flex;
    flex-wrap: wrap;
    /* Textul primului link stă sub marginea logo-ului; zona lui de atingere intră în marginea paginii. */
    margin: 0 0 0 -0.5rem;
    padding: 0;
    list-style: none;
  }

  .meniu a {
    display: inline-flex;
    align-items: center;
    /* Zona de atingere de 44px (§5.8). */
    min-height: 44px;
    padding-inline: 0.5rem;
    color: var(--noapte-text);
    font-size: 1rem;
    text-decoration: none;
  }

  .meniu a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.3em;
  }

  /* Pagina curentă se vede prin greutate și subliniere în --blue-light (antetul e închis la culoare), nu doar prin culoare. */
  .meniu a[aria-current] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--blue-light);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.3em;
  }

  /* Pe telefon (sub 600px), pe paginile cu buton: două rânduri în loc de trei sau patru. „consultant SEO” trece sub nume,
     deci logo-ul se îngustează, iar butonul încape lângă el; meniul are rândul lui, dedesubt. E doar ordinea vizuală
     (`order`): în DOM și la Tab rămâne logo, meniu, buton. Dacă butonul nu încape lângă logo (text mărit la 200%), trece
     pe rândul următor, nu iese din ecran. Logo-ul pe două rânduri are deja 44px, deci padding-ul lui scade. */
  @media (max-width: 37.49rem) {
    .antet__rand--cu-buton {
      column-gap: 1rem;
    }

    .antet__rand--cu-buton .logo {
      padding-block: 0.25rem;
    }

    .antet__rand--cu-buton .logo__rol {
      display: block;
    }

    /* Padding lateral mai mic (tot 44px înălțime): la 320px, cu o bară de derulare clasică, logo-ul și butonul încap alături. */
    .antet__rand--cu-buton > :global(.buton-cta) {
      order: 1;
      padding-inline: calc(0.75rem - 2px);
    }

    .antet__rand--cu-buton > nav {
      order: 2;
      flex-basis: 100%;
    }
  }

  /* Sub 360px, meniul de azi (patru linkuri) nu mai încape pe un rând; cu Proiecte și Ghiduri (șase) trece oricum pe două,
     dar butonul rămâne lângă logo. „Contact” lipsește doar unde butonul „Cere o ofertă” din antet
     duce deja la aceeași pagină (pe /contact/… butonul nu e, deci linkul rămâne). */
  @media (max-width: 22.49rem) {
    .meniu__dublat {
      display: none;
    }
  }
</style>
