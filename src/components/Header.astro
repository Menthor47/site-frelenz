---
// Antetul (§3.3, §4.3 punctul 1, §5.4): logo, meniu și butonul „Cere o ofertă”.
// Butonul lipsește pe Acasă (acolo butonul plin e sub titlu) și pe /contact/ (ar trimite la aceeași pagină).
// „Contact” rămâne în meniu. Componenta nu citește colecțiile: Base îi spune dacă Proiecte și Ghiduri există (§3.4).
import { site } from '../site.config';
import Cta from './Cta.astro';

interface Props {
  /** Calea paginii, cu slash la început și la sfârșit (ex. `/servicii/seo/`). */
  cale: string;
  /** Există cel puțin un proiect publicabil. */
  arataProiecte?: boolean;
  /** Există ghiduri de construit (cel puțin 2 aprobate). */
  arataGhiduri?: boolean;
}

const { cale, arataProiecte = false, arataGhiduri = false } = Astro.props;

const meniu = [
  { href: '/servicii/', text: 'Servicii', arata: true },
  { href: '/cum-lucrez/', text: 'Cum lucrez', arata: true },
  { href: '/proiecte/', text: 'Proiecte', arata: arataProiecte },
  { href: '/ghiduri/', text: 'Ghiduri', arata: arataGhiduri },
  { href: '/despre/', text: 'Despre', arata: true },
  { href: '/contact/', text: 'Contact', arata: true },
].filter((element) => element.arata);

/** „page” pe pagina curentă, „true” pe secțiunea din care face parte (ex. Servicii pe /servicii/seo/). */
const curent = (href: string) => (cale === href ? 'page' : cale.startsWith(href) ? 'true' : undefined);

const faraButon = cale === '/' || cale === '/contact/';
---

<header class="antet">
  <div class="contener antet__rand">
    <a class="logo" href="/" aria-current={cale === '/' ? 'page' : undefined}><span class="logo__nume">{site.nume}</span><span class="logo__virgula">,</span> <span class="logo__rol">{site.logoScurt}</span></a>
    <nav aria-label="Meniu principal">
      <ul class="meniu">
        {
          meniu.map((element) => (
            <li>
              <a href={element.href} aria-current={curent(element.href)}>{element.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {!faraButon && <Cta />}
  </div>
</header>

<style>
  /* Antetul e întunecat pe toate paginile (decizia din 2026-10-23), ca banda de sub el: aceleași culori ca harta. */
  .antet {
    background: #0e1116;
    border-bottom: 1px solid #2a313c;
  }

  /* Ordinea din DOM (logo, meniu, buton) e și ordinea vizuală; pe ecrane înguste rândurile doar trec mai jos. */
  .antet__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding-block: 0.5rem;
  }

  /* Logo (§5.4): „Alex Ionescu” 800 în --ink, virgula în --blue, „consultant SEO” 400 în --ink-2. */
  .logo {
    margin-inline-end: auto;
    /* Zona de atingere de 44px (§5.8), fără flex: spațiul dintre cele trei texte trebuie să rămână. */
    padding-block: 0.6875rem;
    color: #ffffff;
    font-size: var(--text-base);
    line-height: 1.3;
    text-decoration: none;
  }

  .logo__nume {
    font-weight: 800;
  }

  .logo__virgula {
    color: var(--blue);
    font-weight: 800;
  }

  .logo__rol {
    display: inline-block;
    color: #a7b0be;
    font-weight: 400;
  }

  /* Sub 380px, „consultant SEO” trece pe rândul următor. */
  @media (max-width: 379.98px) {
    .logo__rol {
      display: block;
    }
  }

  @media (min-width: 48rem) {
    .logo {
      font-size: var(--text-md);
    }
  }

  .meniu {
    display: flex;
    flex-wrap: wrap;
    /* Textul primului link stă sub marginea logo-ului; zona lui de atingere intră în marginea paginii. */
    margin: 0 0 0 -0.5rem;
    padding: 0;
    list-style: none;
  }

  .meniu a {
    display: inline-flex;
    align-items: center;
    /* Zona de atingere de 44px (§5.8). */
    min-height: 44px;
    padding-inline: 0.5rem;
    color: #e8ecf2;
    font-size: 1rem;
    text-decoration: none;
  }

  .meniu a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.3em;
  }

  /* Pagina curentă se vede prin greutate și subliniere în --blue-light (antetul e închis la culoare), nu doar prin culoare. */
  .meniu a[aria-current] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--blue-light);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.3em;
  }
</style>
