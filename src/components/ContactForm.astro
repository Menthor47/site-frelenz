---
// Formularul de contact (§3.5): trimis prin POST la Worker (/api/contact), care îl validează cu aceleași reguli. Funcționează
// și fără JavaScript. Cu JavaScript (decizia 30), trimiterea se face din pagină, iar o eroare lasă mesajul în câmpuri, cu
// explicația din `[data-eroare]`, sub buton. `required`, `maxlength` și `type` vin din src/form-rules.ts, ca browserul și serverul să judece la fel.
// Fiecare câmp are etichetă vizibilă; cele obligatorii spun asta în text. Nota de sub Mesaj e legată prin `aria-describedby`.
// Capcana e un câmp pe care un om nu-l vede și nu-l atinge: scos din ecran, `tabindex=-1`, `autocomplete=off`,
// într-un bloc `aria-hidden`, cu semnalele prin care 1Password, LastPass, Bitwarden și Dashlane îl lasă gol (A-07).
// Fără CNP și fără bifă de acord.
import { CAMPURI, CAPCANA, FARA_SERVICIU, SERVICII, type NumeCamp } from '../form-rules';
import Iconita from './Iconita.astro';

/** Câmpurile pe un rând, în ordinea din formular. Serviciul și Mesajul au marcajul lor, mai jos. */
const CAMPURI_TEXT: readonly { nume: Exclude<NumeCamp, 'serviciu' | 'mesaj'>; eticheta: string; autocomplete?: string; inputmode?: 'url' }[] = [
  { nume: 'nume', eticheta: 'Nume', autocomplete: 'name' },
  { nume: 'email', eticheta: 'E-mail', autocomplete: 'email' },
  { nume: 'telefon', eticheta: 'Telefon', autocomplete: 'tel' },
  { nume: 'firma', eticheta: 'Firmă', autocomplete: 'organization' },
  // Text liber, ca să meargă și „exemplu.ro” fără https:// (§3.5); `inputmode` aduce doar tastatura potrivită.
  { nume: 'site', eticheta: 'Adresa site-ului', inputmode: 'url' },
];

const servicii = [...SERVICII].sort((a, b) => a.ordine - b.ordine);
const id = (nume: string) => `formular-${nume}`;
const ID_NOTA_MESAJ = 'formular-mesaj-nota';

interface Props {
  /** Id-ul titlului cu contactele directe din pagină: „contactele de pe pagină” din explicația de eroare duc acolo. */
  idContacte: string;
}

const { idContacte } = Astro.props;
---

<form class="formular" method="post" action="/api/contact">
  {
    CAMPURI_TEXT.map((c) => (
      <div class="formular__camp">
        <label for={id(c.nume)}>
          {c.eticheta}
          <span class="formular__obligatoriu">{CAMPURI[c.nume].required ? '(obligatoriu)' : '(opțional)'}</span>
        </label>
        <input
          id={id(c.nume)}
          name={c.nume}
          type={CAMPURI[c.nume].type ?? 'text'}
          required={CAMPURI[c.nume].required}
          maxlength={CAMPURI[c.nume].maxLength}
          autocomplete={c.autocomplete}
          inputmode={c.inputmode}
        />
      </div>
    ))
  }

  <div class="formular__camp">
    <label for={id('serviciu')}>
      Serviciul de care ai nevoie
      <span class="formular__obligatoriu">{CAMPURI.serviciu.required ? '(obligatoriu)' : '(opțional)'}</span>
    </label>
    <select id={id('serviciu')} name="serviciu" required={CAMPURI.serviciu.required}>
      <option value="">Alege un serviciu</option>
      {servicii.map((s) => <option value={s.slug}>{s.nume}</option>)}
      <option value={FARA_SERVICIU.slug}>{FARA_SERVICIU.nume}</option>
    </select>
  </div>

  <div class="formular__camp formular__camp--mesaj">
    <label for={id('mesaj')}>
      Mesaj
      <span class="formular__obligatoriu">{CAMPURI.mesaj.required ? '(obligatoriu)' : '(opțional)'}</span>
    </label>
    <textarea id={id('mesaj')} name="mesaj" required={CAMPURI.mesaj.required} maxlength={CAMPURI.mesaj.maxLength} rows="8" aria-describedby={ID_NOTA_MESAJ}
    ></textarea>
    <p class="formular__nota" id={ID_NOTA_MESAJ}>Cel mult {CAMPURI.mesaj.maxLength} de caractere și cel mult {CAMPURI.mesaj.maxLinkuri} linkuri.</p>
  </div>

  <div class="formular__capcana" aria-hidden="true">
    <label for={id(CAPCANA)}>Nu completa acest câmp</label>
    <input
      id={id(CAPCANA)}
      name={CAPCANA}
      type="text"
      tabindex="-1"
      autocomplete="off"
      data-1p-ignore="true"
      data-lpignore="true"
      data-bwignore="true"
      data-form-type="other"
    />
  </div>

  <div class="formular__trimite">
    <button type="submit" class="buton-cta">Cere o ofertă</button>
    <div class="formular__eroare" role="alert" tabindex="-1" hidden data-eroare>
      <Iconita nume="eroare" />
      <p data-mesaj="linkuri" hidden>
        Mesajul are mai mult de {CAMPURI.mesaj.maxLinkuri} linkuri, dar e încă aici. Scoate câteva linkuri și trimite din nou, sau <span class="fara-rupere">scrie-mi</span> direct, la <a
          href={`#${idContacte}`}>contactele de pe pagină</a
        >.
      </p>
      <p data-mesaj="eroare" hidden>
        Mesajul <span class="fara-rupere">n-a</span> plecat, dar e încă aici. Încearcă din nou peste un minut, sau <span
          class="fara-rupere">scrie-mi</span
        > direct, la <a href={`#${idContacte}`}
          >contactele de pe pagină</a
        >.
      </p>
    </div>
    <p class="formular__nota">
      Folosesc datele trimise ca să-ți răspund la cerere și pentru discuțiile care urmează. Detalii în <a
        href="/politica-de-confidentialitate/">Politica de confidențialitate</a
      >.
    </p>
  </div>
</form>

<script>
  import { initFormular } from '../client/contact-form';

  for (const formular of document.querySelectorAll<HTMLFormElement>('form.formular')) initFormular(formular);
</script>

<style>
  .formular {
    display: grid;
    /* Fără asta, coloana implicită (auto) crește până la cel mai lat câmp și iese din card la text mărit. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    max-width: none;
  }

  /* Containerul e cardul din pagina Contact (`container-type` stă pe el: o interogare nu se aplică elementului care o declară).
     Cu 36rem de lățime sau mai mult, câmpurile stau pe două coloane; Mesajul și butonul iau tot rândul. Capcana e absolută, deci nu intră în grilă. */
  @container (min-width: 36rem) {
    .formular {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.25rem;
    }

    .formular__camp--mesaj,
    .formular__trimite {
      grid-column: 1 / -1;
    }
  }

  label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .formular__obligatoriu {
    color: var(--ink-2);
    font-weight: 400;
  }

  /* Câmpurile: contur de 1px #8A8F98 (3,25:1, §5.2), colțuri drepte, zona de atingere de 44px (§5.8). Focusul e cel global. */
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-border);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
  }

  textarea {
    min-height: 12rem;
    resize: vertical;
  }

  .formular__nota {
    max-width: 60ch;
    overflow-wrap: anywhere;
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  /* Capcana: în afara ecranului, nu `display: none`, ca un robot care ignoră câmpurile ascunse s-o completeze totuși. */
  .formular__capcana {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .formular__trimite {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 0.5rem;
  }

  /* Explicația de după o eroare (doar cu JavaScript, decizia 30): sub buton, pe toată lățimea, cu iconiță și text #B8382A
     (§5.2: erorile au mereu iconiță și text, niciodată doar culoare; 5,07:1 pe --tint-red). Contur de 1px, ca la carduri. */
  .formular__eroare {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 0.75rem;
    justify-self: stretch;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--red-dark);
    background: var(--tint-red);
    color: var(--red-dark);
  }

  /* Iconița de eroare din Iconita (1,25em) stă pe mijlocul primului rând de text (1,6em): (1,6 − 1,25) / 2 = 0,175em. */
  .formular__eroare :global(.iconita) {
    margin-top: 0.175em;
  }

  /* Textul stă lângă iconiță cât are cel puțin 9em; mai îngust (text mărit la 200% pe telefon), trece sub ea, pe toată
     lățimea, în loc să rămână o coloană de câteva litere. */
  .formular__eroare p {
    flex: 1 1 9em;
    min-width: 0;
    margin: 0;
  }

  /* Ascunderea e explicită: `hidden` trebuie să câștige dacă stilul de mai sus pune un `display` pe explicație. */
  .formular__eroare[hidden],
  .formular__eroare [hidden] {
    display: none;
  }

  /* Conturul transparent vine din butoane.css (vizibil în modul de contrast ridicat), deci aici nu se pune `border: 0`. */
  /* Lățimea minimă ține butonul la fel de lat cât spune „Se trimite…” (mai scurt), ca nimic de sub el să nu se miște.
     `min(…, 100%)`: cu textul mărit la 200%, 8,5em ar trece de lățimea cardului (min-width bate max-width). */
  .formular__trimite .buton-cta {
    min-width: min(8.5em, 100%);
    max-width: 100%;
    cursor: pointer;
  }
</style>
