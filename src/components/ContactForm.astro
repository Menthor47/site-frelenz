---
// Formularul de contact (§3.5): trimis prin POST la Worker (/api/contact), care îl validează cu aceleași reguli. Funcționează
// și fără JavaScript. Cu JavaScript (decizia 30), trimiterea se face din pagină, iar o eroare lasă mesajul în câmpuri, cu
// explicația din `[data-eroare]`, sub buton. `required`, `maxlength` și `type` vin din src/form-rules.ts, ca browserul și serverul să judece la fel.
// Fiecare câmp are etichetă vizibilă; cele obligatorii spun asta în text. Nota de sub Mesaj e legată prin `aria-describedby`.
// Capcana e un câmp pe care un om nu-l vede și nu-l atinge: scos din ecran, `tabindex=-1`, `autocomplete=off`,
// într-un bloc `aria-hidden`, cu semnalele prin care 1Password, LastPass, Bitwarden și Dashlane îl lasă gol (A-07).
// Fără CNP și fără bifă de acord.
// Scriptul din browser nu importă src/form-rules.ts (datele lui ar intra în bundle și ar trece de bugetul de 2 KB al scriptului): regulile
// le citește de aici, din marcajul scris din aceleași date. Lungimea maximă a Mesajului e `maxlength`; numărul maxim de linkuri,
// `data-max-linkuri`; serviciile permise, valorile nevide ale listei.
// Formularul e un traseu cu trei stații (spec metroul îmbunătățit, §4): fiecare grup de câmpuri e un `fieldset` cu legendă, iar
// legenda e și numele grupului pentru cititoarele de ecran. Ordinea, numele și regulile câmpurilor nu s-au schimbat. Linia
// verticală care leagă stațiile și umplerea lor sunt doar CSS (mai jos); scriptul adaugă doar erorile și contorul.
import type { CampCuMesaj } from '../client/contact-form';
import { CAMPURI, CAPCANA, FARA_SERVICIU, SERVICII, type NumeCamp } from '../form-rules';
import Iconita from './Iconita.astro';

/** Câmpurile pe un rând, după nume. Serviciul și Mesajul au marcajul lor, mai jos. */
const CAMPURI_TEXT: Readonly<Record<Exclude<NumeCamp, 'serviciu' | 'mesaj'>, { eticheta: string; autocomplete?: string; inputmode?: 'url' }>> = {
  nume: { eticheta: 'Nume', autocomplete: 'name' },
  email: { eticheta: 'E-mail', autocomplete: 'email' },
  telefon: { eticheta: 'Telefon', autocomplete: 'tel' },
  firma: { eticheta: 'Firmă', autocomplete: 'organization' },
  // Text liber, ca să meargă și „exemplu.ro” fără https:// (§3.5); `inputmode` aduce doar tastatura potrivită.
  site: { eticheta: 'Adresa site-ului', inputmode: 'url' },
};

/** Cele trei stații, cu legendele din spec (§4, §8), în ordinea din formular. A doua e opțională: nu se umple și nu blochează nimic. */
const STATII: readonly { legenda: string; optionala?: true; campuri: readonly NumeCamp[] }[] = [
  { legenda: '1. Cine ești', campuri: ['nume', 'email', 'telefon', 'firma'] },
  { legenda: '2. Site-ul tău (opțional)', optionala: true, campuri: ['site', 'serviciu'] },
  { legenda: '3. Ce te încurcă', campuri: ['mesaj'] },
];

/** Câmpurile cu un loc pentru mesajul de eroare, imediat sub ele (scriptul îl scrie, A-08). Sunt cele pe care le știe scriptul. */
const CU_EROARE: ReadonlySet<string> = new Set<CampCuMesaj>(['nume', 'email', 'mesaj']);

const servicii = [...SERVICII].sort((a, b) => a.ordine - b.ordine);
const id = (nume: string) => `formular-${nume}`;
const idEroare = (nume: string) => `${id(nume)}-eroare`;
const ID_NOTA_MESAJ = 'formular-mesaj-nota';
const ID_CONTOR_MESAJ = 'formular-mesaj-contor';

interface Props {
  /** Id-ul titlului cu contactele directe din pagină: „contactele de pe pagină” din explicația de eroare duc acolo. */
  idContacte: string;
}

const { idContacte } = Astro.props;
---

<form class="formular" method="post" action="/api/contact">
  {
    STATII.map((statie) => (
      <fieldset class:list={['formular__statie', { 'formular__statie--optionala': statie.optionala }]}>
        <legend>{statie.legenda}</legend>
        {statie.campuri.map((nume) =>
          nume === 'serviciu' ? (
            <div class="formular__camp">
              <label for={id('serviciu')}>
                Serviciul de care ai nevoie
                <span class="formular__obligatoriu">{CAMPURI.serviciu.required ? '(obligatoriu)' : '(opțional)'}</span>
              </label>
              <select id={id('serviciu')} name="serviciu" required={CAMPURI.serviciu.required}>
                <option value="">Alege un serviciu</option>
                {/* `data-grup` dă culoarea liniei formularului (regulile `:has()` de mai jos); „Alege un serviciu” și „Nu știu încă” n-au grup. */}
                {servicii.map((s) => (
                  <option value={s.slug} data-grup={s.grup}>
                    {s.nume}
                  </option>
                ))}
                <option value={FARA_SERVICIU.slug}>{FARA_SERVICIU.nume}</option>
              </select>
            </div>
          ) : nume === 'mesaj' ? (
            <div class="formular__camp formular__camp--mesaj">
              <label for={id('mesaj')}>
                Mesaj
                <span class="formular__obligatoriu">{CAMPURI.mesaj.required ? '(obligatoriu)' : '(opțional)'}</span>
              </label>
              <textarea
                id={id('mesaj')}
                name="mesaj"
                required={CAMPURI.mesaj.required}
                maxlength={CAMPURI.mesaj.maxLength}
                rows="8"
                aria-describedby={ID_NOTA_MESAJ}
                data-max-linkuri={CAMPURI.mesaj.maxLinkuri}
              />
              <p class="formular__eroare-camp" id={idEroare('mesaj')} hidden />
              <p class="formular__nota" id={ID_NOTA_MESAJ}>
                Cel mult {CAMPURI.mesaj.maxLength} de caractere și cel mult {CAMPURI.mesaj.maxLinkuri} linkuri.
              </p>
              {/* Ascuns până îl arată scriptul: fără JavaScript cifrele n-ar mai fi adevărate după tastare. Fără anunțuri la fiecare literă. */}
              <p class="formular__contor" id={ID_CONTOR_MESAJ} aria-live="off" hidden />
            </div>
          ) : (
            <div class="formular__camp">
              <label for={id(nume)}>
                {CAMPURI_TEXT[nume].eticheta}
                <span class="formular__obligatoriu">{CAMPURI[nume].required ? '(obligatoriu)' : '(opțional)'}</span>
              </label>
              <input
                id={id(nume)}
                name={nume}
                type={CAMPURI[nume].type ?? 'text'}
                required={CAMPURI[nume].required}
                maxlength={CAMPURI[nume].maxLength}
                autocomplete={CAMPURI_TEXT[nume].autocomplete}
                inputmode={CAMPURI_TEXT[nume].inputmode}
              />
              {CU_EROARE.has(nume) && <p class="formular__eroare-camp" id={idEroare(nume)} hidden />}
            </div>
          ),
        )}
      </fieldset>
    ))
  }

  <div class="formular__capcana" aria-hidden="true">
    <label for={id(CAPCANA)}>Nu completa acest câmp</label>
    <input
      id={id(CAPCANA)}
      name={CAPCANA}
      type="text"
      tabindex="-1"
      autocomplete="off"
      data-1p-ignore="true"
      data-lpignore="true"
      data-bwignore="true"
      data-form-type="other"
    />
  </div>

  <div class="formular__trimite">
    {/* Capătul liniei: butonul e ultima stație, cu eticheta ei lângă el. Eticheta e text vizibil, nu `aria-hidden`. */}
    <div class="formular__capat">
      <button type="submit" class="buton-cta">Cere o ofertă</button>
      <p class="formular__destinatie">Destinația: oferta ta</p>
    </div>
    <div class="formular__eroare" role="alert" tabindex="-1" hidden data-eroare>
      <Iconita nume="eroare" />
      <p data-mesaj="linkuri" hidden>
        Mesajul are mai mult de {CAMPURI.mesaj.maxLinkuri} linkuri, dar e încă aici. Scoate câteva linkuri și trimite din nou, sau <span class="fara-rupere">scrie-mi</span> direct, la <a
          href={`#${idContacte}`}>contactele de pe pagină</a
        >.
      </p>
      <p data-mesaj="eroare" hidden>
        Mesajul <span class="fara-rupere">n-a</span> plecat, dar e încă aici. Încearcă din nou peste un minut, sau <span
          class="fara-rupere">scrie-mi</span
        > direct, la <a href={`#${idContacte}`}
          >contactele de pe pagină</a
        >.
      </p>
    </div>
    <p class="formular__nota">
      Folosesc datele trimise ca să-ți răspund la cerere și pentru discuțiile care urmează. Detalii în <a
        href="/politica-de-confidentialitate/">Politica de confidențialitate</a
      >.
    </p>
  </div>
</form>

<script>
  import { initFormular } from '../client/contact-form';

  for (const formular of document.querySelectorAll<HTMLFormElement>('form.formular')) initFormular(formular);
</script>

<style>
  /* Traseul (spec metroul îmbunătățit, §4). Pe un card lat, o linie verticală de 4px leagă stațiile pe marginea din stânga;
     fiecare legendă are bulina ei pe linie, iar butonul e capătul. Sub 36rem linia dispare, iar legendele își păstrează bulina,
     în rând cu textul. Culoarea liniei și a stațiilor pline e `--culoare-linie`: cerneală, sau culoarea grupului serviciului ales.
     Măsurile stau în variabile, ca linia, bulinele și capătul să se potrivească între ele:
     - `--bulina`: diametrul bulinei; centrul ei e pe linie, la `--bulina / 2` de marginea din stânga a formularului;
     - `--stalp`: locul lăsat în stânga pentru linie și bulină, înaintea câmpurilor;
     - `--legenda`, `--rand-legenda`: mărimea și înălțimea rândului legendei, ca linia să înceapă pe centrul primei buline;
     - `--sep`: aerul dintre stații;
     - `--centru-buton`: de la marginea de sus a rândului butonului până la centrul butonului (jumătate din cei 44px, §5.8). */
  .formular {
    --culoare-linie: var(--ink);
    --bulina: 1.5rem;
    --stalp: 2.75rem;
    --legenda: var(--text-md);
    --rand-legenda: 1.3;
    --sep: 2rem;
    --centru-buton: 1.375rem;

    /* `relative`: linia și capcana se măsoară de la formular. */
    position: relative;
    display: grid;
    /* Fără asta, coloana implicită (auto) crește până la cel mai lat câmp și iese din card la text mărit. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sep);
    max-width: none;
  }

  /* Culoarea liniei: cea a grupului serviciului ales în listă, după `data-grup` de pe `<option>` (tokens.css: pe alb, galbenul
     tare n-ar avea 3:1, deci construcția ia galbenul închis). Fără serviciu ales, sau cu „Nu știu încă” (fără grup), rămâne cerneala.
     Fără `:has()` (Firefox sub 121, Safari sub 15.4) linia rămâne cerneală, iar formularul merge la fel. */
  .formular:has(option[data-grup='vizibilitate']:checked) {
    --culoare-linie: var(--blue);
  }

  .formular:has(option[data-grup='diagnostic']:checked) {
    --culoare-linie: var(--green);
  }

  .formular:has(option[data-grup='constructie']:checked) {
    --culoare-linie: var(--yellow-dark);
  }

  .formular:has(option[data-grup='reparatie']:checked) {
    --culoare-linie: var(--red);
  }

  /* Linia: un element de grilă absolut, pe rândurile celor trei stații (1 / 4); `bottom` negativ o duce până la centrul butonului,
     din rândul de sub ele. Începe pe centrul primei buline. Ascunsă implicit: apare doar pe un card lat, mai jos. */
  .formular::before {
    content: '';
    display: none;
    position: absolute;
    grid-area: 1 / 1 / 4 / 2;
    top: calc(var(--legenda) * var(--rand-legenda) / 2);
    bottom: calc(-1 * (var(--sep) + var(--centru-buton)));
    left: calc(var(--bulina) / 2 - var(--stalp) - 2px);
    width: 4px;
    background: var(--culoare-linie);
  }

  /* O stație: fără chenarul implicit al `fieldset`-ului. `min-width: 0` (implicit e `min-content`) ca să nu iasă din card la text mărit.
     Grila câmpurilor stă aici, în fiecare stație; pe un card lat are două coloane. */
  .formular__statie {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Legenda numește stația (și grupul, pentru cititoarele de ecran). Bulina din `::before`: inel gol, plin când stația e completată. */
  legend {
    position: relative;
    margin-bottom: 1rem;
    padding: 0;
    /* Cu textul mărit la 200% pe un ecran de 320px, „(opțional)” e mai lat decât rândul: se rupe, nu iese din card. */
    overflow-wrap: anywhere;
    font-size: var(--legenda);
    font-weight: 700;
    line-height: var(--rand-legenda);
  }

  /* Pe un card îngust nu e linie: bulina stă în rând cu legenda. */
  legend::before {
    content: '';
    display: inline-block;
    box-sizing: border-box;
    width: var(--bulina);
    height: var(--bulina);
    margin-inline-end: 0.5rem;
    border: 3px solid var(--culoare-linie);
    border-radius: 50%;
    background: var(--card);
    vertical-align: middle;
  }

  /* Stația se umple când câmpurile ei obligatorii sunt toate valide. Cea opțională (fără `required`) nu se umple niciodată și nu blochează nimic. */
  .formular__statie:has(:required):not(:has(:invalid)) > legend::before {
    background: var(--culoare-linie);
  }

  /* Cardul lat: două coloane în stații, loc în stânga pentru linie, bulinele pe linie, capătul liniei lângă buton.
     Containerul e cardul din pagina Contact (`container-type` stă pe el: o interogare nu se aplică elementului care o declară). */
  @container (min-width: 36rem) {
    .formular {
      padding-inline-start: var(--stalp);
    }

    .formular::before {
      display: block;
    }

    .formular__statie {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.25rem;
    }

    .formular__camp--mesaj {
      grid-column: 1 / -1;
    }

    legend::before {
      position: absolute;
      top: calc((var(--legenda) * var(--rand-legenda) - var(--bulina)) / 2);
      left: calc(-1 * var(--stalp));
      margin: 0;
    }

    /* Capătul: ultima stație, un disc cu inel, pe linie, în dreptul butonului. */
    .formular__capat::before {
      content: '';
      display: block;
      position: absolute;
      box-sizing: border-box;
      top: calc(var(--centru-buton) - var(--bulina) / 2);
      left: calc(-1 * var(--stalp));
      width: var(--bulina);
      height: var(--bulina);
      border: 3px solid var(--culoare-linie);
      border-radius: 50%;
      background: var(--culoare-linie);
      box-shadow: inset 0 0 0 3px var(--card);
    }
  }

  label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .formular__obligatoriu {
    color: var(--ink-2);
    font-weight: 400;
  }

  /* Câmpurile: contur de 1px #8A8F98 (3,25:1, §5.2), colțuri drepte, zona de atingere de 44px (§5.8). Focusul e cel global. */
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-border);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
  }

  textarea {
    min-height: 12rem;
    resize: vertical;
  }

  .formular__nota,
  .formular__contor {
    max-width: 60ch;
    overflow-wrap: anywhere;
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  /* Eroarea de sub câmp (A-08, scrisă de script): #B8382A pe alb, cu un semn „!” într-un cerc înaintea textului, ca să nu stea doar în
     culoare (§5.2). Semnul are text alternativ gol, deci cititoarele de ecran citesc doar mesajul. `hidden` trebuie să câștige peste `display: flex`. */
  .formular__eroare-camp {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    max-width: 60ch;
    margin: 0.35rem 0 0;
    color: var(--red-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .formular__eroare-camp[hidden] {
    display: none;
  }

  .formular__eroare-camp::before {
    content: '!';
    content: '!' / '';
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 1.25em;
    height: 1.25em;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: 0.85em;
    line-height: 1;
  }

  /* Capcana: în afara ecranului, nu `display: none`, ca un robot care ignoră câmpurile ascunse s-o completeze totuși. */
  .formular__capcana {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .formular__trimite {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 0.5rem;
  }

  /* Rândul butonului: eticheta capătului lângă el; la text mărit trece sub buton. Stă pe linie, deci e reper pentru bulina capătului. */
  .formular__capat {
    position: relative;
    /* Pe toată lățimea rândului (`justify-items: start` l-ar strânge la lățimea conținutului, iar rotunjirile îl rup pe două rânduri). */
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    max-width: 100%;
  }

  .formular__destinatie {
    margin: 0;
    font-weight: 700;
  }

  /* Explicația de după o eroare (doar cu JavaScript, decizia 30): sub buton, pe toată lățimea, cu iconiță și text #B8382A
     (§5.2: erorile au mereu iconiță și text, niciodată doar culoare; 5,07:1 pe --tint-red). Contur de 1px, ca la carduri. */
  .formular__eroare {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 0.75rem;
    justify-self: stretch;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--red-dark);
    background: var(--tint-red);
    color: var(--red-dark);
  }

  /* Iconița de eroare din Iconita (1,25em) stă pe mijlocul primului rând de text (1,6em): (1,6 − 1,25) / 2 = 0,175em. */
  .formular__eroare :global(.iconita) {
    margin-top: 0.175em;
  }

  /* Textul stă lângă iconiță cât are cel puțin 9em; mai îngust (text mărit la 200% pe telefon), trece sub ea, pe toată
     lățimea, în loc să rămână o coloană de câteva litere. */
  .formular__eroare p {
    flex: 1 1 9em;
    min-width: 0;
    margin: 0;
  }

  /* Ascunderea e explicită: `hidden` trebuie să câștige dacă stilul de mai sus pune un `display` pe explicație. */
  .formular__eroare[hidden],
  .formular__eroare [hidden] {
    display: none;
  }

  /* Conturul transparent vine din butoane.css (vizibil în modul de contrast ridicat), deci aici nu se pune `border: 0`. */
  /* Lățimea minimă ține butonul la fel de lat cât spune „Se trimite…” (mai scurt), ca nimic de sub el să nu se miște.
     `min(…, 100%)`: cu textul mărit la 200%, 8,5em ar trece de lățimea cardului (min-width bate max-width). */
  .formular__trimite .buton-cta {
    min-width: min(8.5em, 100%);
    max-width: 100%;
    cursor: pointer;
  }

  /* Cu culorile forțate (modul de contrast ridicat) fundalurile dispar: linia și stațiile pline trec pe culoarea textului, cele goale
     pe culoarea paginii; conturul bulinelor capătă singur culoarea sistemului. */
  @media (forced-colors: active) {
    .formular::before,
    .formular__capat::before {
      background: CanvasText;
    }

    legend::before {
      background: Canvas;
    }

    /* Regula cu `:has()` e separată de cele de mai sus: un browser fără `:has()` aruncă toată regula cu selectorul necunoscut, iar
       linia și capătul ar rămâne fără culoare. Stă după `legend::before` (o întrece oricum, prin specificitate) tocmai ca să
       nu fie vecină cu regula identică de mai sus: minificatorul lipește regulile vecine cu aceleași declarații într-o singură
       listă de selectori, adică ar reface regula pe care am despărțit-o. */
    .formular__statie:has(:required):not(:has(:invalid)) > legend::before {
      background: CanvasText;
    }
  }
</style>
