{
  "name": "siteulet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "preview:draft": "cross-env DRAFT=1 astro build",
    "preview:draft:serve": "cross-env DRAFT=1 astro preview",
    "test": "npm run test:unit && npm run test:worker",
    "verify": "astro check && npm test && npm run build && npm run check && npm run check:links",
    "test:unit": "vitest run",
    "report:placeholders": "node scripts/report-placeholders.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check-cedilla.mjs && node scripts/check-font-glyphs.mjs",
    "qa:page": "node scripts/qa-page.mjs",
    "check:links": "linkinator dist --recurse --skip \"^https?://(?!127[.]0[.]0[.]1)\"",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "check:launch": "npm run report:placeholders && node scripts/check-launch.mjs",
    "deploy": "npm run verify && npm run check:launch && wrangler deploy",
    "report": "node scripts/report-final.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1",
    "mimetext": "3.0.28"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "chrome-launcher": "1.2.2",
    "cross-env": "10.1.0",
    "fontkit": "2.0.4",
    "html-validate": "11.17.0",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "satori": "0.30.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
